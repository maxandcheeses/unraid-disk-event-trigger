                <input type="text" class="htt-name" value="${(rule.name||'').replace(/"/g,'&quot;')}" placeholder="Rule name" style="width:200px">
                ${httBadgeHtml(rule)}
                <span class="htt-rule-actions">
                    <button type="button" class="htt-rule-header-save" onclick="httSaveRule(${i})" title="Unsaved changes - save and apply this rule" style="display:${dirty?'':'none'};font-weight:600">Save &amp; Apply</button>
                    <button type="button" onclick="httMoveRule(${i},-1)" ${i===0?'disabled':''} title="Move up (rules run in this order)">&#8593;</button>
                    <button type="button" onclick="httMoveRule(${i},1)" ${i===httRules.length-1?'disabled':''} title="Move down (rules run in this order)">&#8595;</button>
                    <button type="button" onclick="httDuplicateRule(${i})">Duplicate</button>
                    <button type="button" onclick="httTestRule(${i})" title="Fires this rule's configured action once, regardless of current temp/usage/array state">Test</button>
                    <button type="button" onclick="httRemoveRule(${i})">Remove</button>
                </span>
            </h4>
            <div class="row htt-rule-test-msg" style="opacity:0.85"></div>
            <div class="rule-body">
            <div class="row" style="opacity:0.75">Conditions <span class="htt-help" title="This rule fires once its conditions evaluate true, combined left-to-right with each condition's own AND/OR (no parentheses/precedence) - e.g. 'disk temp &#8804; 35C' AND 'no parity check/rebuild active', so a temperature-driven fan-off doesn't fight a separate 'keep the fan on during parity check' rule over the same relay.">&#9432;</span></div>
            <div class="htt-conditions">${rule.conditions.map((cond, ci) => httConditionBlock(cond, i, ci, rule.conditions.length, rule.id)).join('')}</div>
            <div class="row">
                <button type="button" onclick="httAddCondition(${i})">+ Add Condition</button>
                <button type="button" onclick="httTestConditions(${i})" title="Evaluates these conditions right now against live disk/array state, without sending any command">Test Conditions</button>
            </div>
            <div class="htt-cond-results"></div>
            <hr style="border:none;border-top:1px solid #666;margin:12px 0">
            <div class="row">
                <label>Delay</label>
                <input type="number" class="htt-delay" min="0" style="width:70px" value="${rule.delay_seconds ?? 0}"> sec <span class="htt-help" title="Only fire once the conditions have held continuously (all at once) for this many seconds. If they revert before the delay elapses, the action is never sent. 0 = fire immediately.">&#9432;</span>
            </div>
            <hr style="border:none;border-top:1px solid #666;margin:12px 0">
            <div class="row">
                <label>Force resend</label>
                <label style="min-width:auto"><input type="checkbox" class="htt-force-resend" ${rule.force_resend?'checked':''}> re-send this action every poll cycle while the conditions hold, even after it's already fired</label>
            </div>
            <div class="row">
                <label>Also reset <span class="htt-help" title="When this rule fires (transitions from not-fired to fired), also clear the checked rules' own fired flag - e.g. an ON rule resetting its paired OFF rule so hysteresis pairs don't get stuck. Only happens on that transition, not on every force-resend re-assertion.">&#9432;</span></label>
                <div class="disk-list">${httResetRulesCheckboxes(rule, i)}</div>
            </div>
            <div class="row">
                <label>Protocol</label>
                <select class="htt-protocol" onchange="httToggleProto(this)">
                    <option value="http" ${rule.protocol!=='mqtt'&&rule.protocol!=='webhook'?'selected':''}>Tasmota HTTP</option>
                    <option value="mqtt" ${rule.protocol==='mqtt'?'selected':''}>MQTT (Tasmota or zigbee2mqtt)</option>
                    <option value="webhook" ${rule.protocol==='webhook'?'selected':''}>Generic HTTP/HTTPS webhook</option>
                </select>
            </div>
            <div class="proto-block htt-http-block ${rule.protocol!=='mqtt'&&rule.protocol!=='webhook'?'active':''}">
                <div class="row"><label>Command</label>
                    <select class="htt-http-state">
                        <option value="on" ${rule.http?.state==='off'?'':'selected'}>Power On</option>
                        <option value="off" ${rule.http?.state==='off'?'selected':''}>Power Off</option>
                    </select>
                </div>
                <div class="row"><label>Connection</label><select class="htt-http-conn" onchange="httToggleRuleConn(this)">${httConnectionOptions('http', rule.http?.connection_id||'')}</select></div>
                <div class="htt-http-connfields" style="display:${rule.http?.connection_id?'none':''}">
                <div class="row"><label>Device base URL</label><input type="text" class="htt-http-url" value="${(rule.http?.base_url)||''}" placeholder="http://192.168.1.50"></div>
                <div class="row"><label>Username</label><input type="text" class="htt-http-user" value="${(rule.http?.username)||''}"></div>
                <div class="row"><label>Password</label>${httPassField('htt-http-pass', (rule.http?.password)||'')}</div>
                </div>
                <div class="row"><label>Relay index (optional)</label><input type="text" class="htt-http-idx" value="${(rule.http?.device_index)||''}" placeholder="e.g. 2 for Power2"></div>
                <div class="row"><button type="button" onclick="httCheckState(${i})">Check Device State</button></div>
            </div>
            <div class="proto-block htt-mqtt-block ${rule.protocol==='mqtt'?'active':''}">
                <div class="row"><label>Connection</label><select class="htt-mqtt-conn" onchange="httToggleRuleConn(this)">${httConnectionOptions('mqtt', rule.mqtt?.connection_id||'')}</select></div>
                <div class="htt-mqtt-connfields" style="display:${rule.mqtt?.connection_id?'none':''}">
                <div class="row"><label>Broker host</label><input type="text" class="htt-mqtt-host" value="${(rule.mqtt?.host)||''}" placeholder="192.168.1.10"></div>
                <div class="row"><label>Broker port</label><input type="number" class="htt-mqtt-port" value="${(rule.mqtt?.port)||1883}"></div>
                <div class="row"><label style="min-width:auto"><input type="checkbox" class="htt-mqtt-tls" ${rule.mqtt?.tls?'checked':''}> Use TLS (mqtts, typically port 8883)</label></div>
                <div class="row"><label style="min-width:auto"><input type="checkbox" class="htt-mqtt-insecure" ${rule.mqtt?.insecure_tls?'checked':''}> Ignore invalid/self-signed broker certificates</label> <span class="htt-help" title="Skips TLS certificate verification for this broker. Only enable for trusted LAN brokers with self-signed certs - this disables protection against man-in-the-middle attacks.">&#9432;</span></div>
                <div class="row"><label>Username</label><input type="text" class="htt-mqtt-user" value="${(rule.mqtt?.username)||''}"></div>
                <div class="row"><label>Password</label>${httPassField('htt-mqtt-pass', (rule.mqtt?.password)||'')}</div>
                </div>
                <div class="row"><label>Topic</label><input type="text" class="htt-mqtt-topic" value="${(rule.mqtt?.topic)||''}" placeholder="cmnd/tasmota_xx/POWER  or  zigbee2mqtt/plug/set"></div>
                <div class="row"><label>Payload</label><input type="text" class="htt-mqtt-payload" value="${(rule.mqtt?.payload)||(direction==='off'?'OFF':'ON')}"></div>
                <div class="row"><label>State topic (optional)</label><input type="text" class="htt-mqtt-statetopic" value="${(rule.mqtt?.state_topic)||''}" placeholder="zigbee2mqtt/plug (device's own state topic, not /set)"></div>
                <div class="row"><label>Payload is JSON</label><label style="min-width:auto"><input type="checkbox" class="htt-mqtt-statejson" onchange="this.closest('.row').nextElementSibling.style.display=this.checked?'':'none'" ${rule.mqtt?.state_is_json?'checked':''}> parse as JSON, e.g. zigbee2mqtt's {"state":"ON"} (leave unchecked to compare the raw payload directly)</label></div>
                <div class="row" style="display:${rule.mqtt?.state_is_json?'':'none'}"><label>State JSON key</label><input type="text" class="htt-mqtt-statekey" value="${(rule.mqtt?.state_json_key)||'state'}" placeholder="state"></div>
                <hr style="border:none;border-top:1px solid #666;margin:12px 0">
                <div class="row" style="opacity:0.75">Debug-only: how to interpret the state topic's raw value, used only by "Check Device State".</div>
                <div class="row"><label>Reports ON as</label><input type="text" class="htt-mqtt-state-on" value="${(rule.mqtt?.state_on_value)||'ON'}"></div>
                <div class="row"><label>Reports OFF as</label><input type="text" class="htt-mqtt-state-off" value="${(rule.mqtt?.state_off_value)||'OFF'}"></div>
                <div class="row"><button type="button" onclick="httCheckState(${i})">Check Device State</button></div>
            </div>
            <div class="proto-block htt-webhook-block ${rule.protocol==='webhook'?'active':''}">
                <div class="row"><label>Connection</label><select class="htt-webhook-conn" onchange="httToggleRuleConn(this)">${httConnectionOptions('webhook', rule.webhook?.connection_id||'')}</select></div>
                <div class="row"><label>Method</label>
                    <select class="htt-webhook-method">
                        ${['GET','POST','PUT','PATCH','DELETE'].map(m => `<option value="${m}" ${(rule.webhook?.method||'GET')===m?'selected':''}>${m}</option>`).join('')}
                    </select>
                </div>
                <div class="row"><label>URL</label><input type="text" class="htt-webhook-url" value="${(rule.webhook?.url)||''}" placeholder="https://host/api/toggle"></div>
                <div class="row"><label>Body (optional)</label><input type="text" class="htt-webhook-body" value="${(rule.webhook?.body)||''}" placeholder="raw request body for POST/PUT/PATCH"></div>
                <hr style="border:none;border-top:1px solid #666;margin:12px 0">
                <div class="row" style="opacity:0.75">Shared settings below apply to the action above and the state check.</div>
                <div class="htt-webhook-connfields" style="display:${rule.webhook?.connection_id?'none':''}">
                <div class="row"><label>Headers (optional)</label><textarea class="htt-webhook-headers" style="width:320px;height:60px;font-family:monospace;font-size:12px" placeholder="Content-Type: application/json&#10;X-Api-Key: xxxx">${(rule.webhook?.headers)||''}</textarea></div>
                <div class="row"><label>Username (optional)</label><input type="text" class="htt-webhook-user" value="${(rule.webhook?.username)||''}"></div>
                <div class="row"><label>Password (optional)</label>${httPassField('htt-webhook-pass', (rule.webhook?.password)||'')}</div>
                <div class="row"><label style="min-width:auto"><input type="checkbox" class="htt-webhook-insecure" ${rule.webhook?.insecure_tls?'checked':''}> Ignore invalid/self-signed HTTPS certificates</label> <span class="htt-help" title="Skips TLS certificate verification for this endpoint. Only enable for trusted LAN devices with self-signed certs - this disables protection against man-in-the-middle attacks.">&#9432;</span></div>
                </div>
                <hr style="border:none;border-top:1px solid #666;margin:12px 0">
                <div class="row" style="opacity:0.75">Debug-only: used by "Check Device State" below, not by the action above.</div>
                <div class="row"><label>State URL (optional)</label><input type="text" class="htt-webhook-state-url" value="${(rule.webhook?.state_url)||''}" placeholder="https://host/api/status"></div>
                <div class="row"><label>State method</label>
                    <select class="htt-webhook-state-method">
                        ${['GET','POST','PUT','PATCH','DELETE'].map(m => `<option value="${m}" ${(rule.webhook?.state_method||'GET')===m?'selected':''}>${m}</option>`).join('')}
                    </select>
                </div>
                <div class="row"><button type="button" onclick="httCheckState(${i})">Check Device State</button></div>
            </div>
            <div class="htt-checkstate-results"></div>
            <hr style="border:none;border-top:1px solid #666;margin:12px 0">
            <div class="row">
                <button type="button" onclick="httSaveRule(${i})">Save &amp; Apply</button>
                <span class="htt-rule-save-msg"></span>
            </div>
            </div>
        `;
        wrap.appendChild(box);
        box.addEventListener('input', () => httUpdateRuleDirtyIndicator(box));
        box.addEventListener('change', () => httUpdateRuleDirtyIndicator(box));
    });
}

/** Hides a rule's manual connection-level fields (host/user/pass/etc.) once it's tied to a saved connection. */
function httToggleRuleConn(sel) {
    const wrap = sel.closest('.proto-block').querySelector('[class$="-connfields"]');
    if (wrap) wrap.style.display = sel.value ? 'none' : '';
}

function httToggleProto(sel) {
    const box = sel.closest('.rule-box');
    box.querySelector('.htt-http-block').classList.toggle('active', sel.value === 'http');
    box.querySelector('.htt-mqtt-block').classList.toggle('active', sel.value === 'mqtt');
    box.querySelector('.htt-webhook-block').classList.toggle('active', sel.value === 'webhook');
}

function httToggleCollapse(i) {
    httCollectRules(); // otherwise re-rendering every box would discard unsaved edits in any other rule
    const rule = httRules[i];
    const key = rule.id || ('idx' + i);
    const currentlyCollapsed = key in httCollapsedOverride ? httCollapsedOverride[key] : (httRules.length > 1);
    httCollapsedOverride[key] = !currentlyCollapsed;
    httRenderRules();
}

/** True once a rule has been added/removed/duplicated/reordered but not yet saved - individual field edits are tracked separately, per rule. */
let httRulesStructureDirty = false;

function httUpdateRulesStructureButton() {
    const btn = document.getElementById('htt-rules-structure-save');
    if (btn) btn.style.display = httRulesStructureDirty ? '' : 'none';
}

/** Persists the whole rule list/order as-is - only called explicitly via the "Save & Apply" button below, not automatically on add/remove/move/duplicate. */
function httSaveRulesStructure() {
    const msg = document.getElementById('htt-save-msg');
    if (msg) msg.textContent = ' Saving...';
    httPost('action=save_rules&rules=' + encodeURIComponent(JSON.stringify(httRules)))
        .then(r => r.json()).then(d => {
            if (msg) {
                msg.textContent = d.ok ? ' Saved and applied.' : ' Error saving: ' + (d.error || 'unknown error');
                setTimeout(() => msg.textContent = '', 3000);
            }
            if (d.ok) {
                httRulesStructureDirty = false;
                httSnapshotRules(httRules); // also clears each rule's own header Save button, since save_rules persists their current in-memory content too
                httUpdateRulesStructureButton();
                httRenderRules();
            }
        }).catch(err => {
            if (msg) msg.textContent = ' Error saving: ' + err;
        });
}

function httAddRule() {
    httCollectRules(); // otherwise re-rendering every box would discard unsaved edits in any other rule
    const newRule = { id: httUid(), name: 'New Rule', enabled: true, conditions: [{ trigger_type: 'temp', disks: ['all'], aggregate: 'max', direction: 'on', threshold: 40 }], delay_seconds: 0, force_resend: false, reset_rules: [], protocol: 'http', http: { state: 'on' }, mqtt: {}, webhook: {} };
    httRules.push(newRule);
    httCollapsedOverride[newRule.id] = false; // keep the newly added rule open for editing
    httRulesStructureDirty = true;
    httRenderRules();
    httUpdateRulesStructureButton();
}

function httDuplicateRule(i) {
    httCollectRules();
    const clone = JSON.parse(JSON.stringify(httRules[i]));
    clone.id = httUid();
    clone.name = (clone.name || 'Rule') + ' (copy)';
    httRules.splice(i + 1, 0, clone);
    httCollapsedOverride[clone.id] = false; // keep the new copy open for editing
    httRulesStructureDirty = true;
    httRenderRules();
    httUpdateRulesStructureButton();
}

function httRemoveRule(i) {
    httCollectRules();
    httRules.splice(i, 1);
    httRulesStructureDirty = true;
    httRenderRules();
    httUpdateRulesStructureButton();
}

/** Rules run in this order (top to bottom) - matches poll-cycle execution order 1:1. */
function httMoveRule(i, delta) {
    httCollectRules();
    const j = i + delta;
    if (j < 0 || j >= httRules.length) return;
    [httRules[i], httRules[j]] = [httRules[j], httRules[i]];
    httRulesStructureDirty = true;
    httRenderRules();
    httUpdateRulesStructureButton();
}

function httCollectRuleFromBox(box, orig) {
    orig = orig || {};
    const conditions = Array.from(box.querySelectorAll('.htt-cond-block')).map((cb, ci) => {
        const diskChecks = cb.querySelectorAll('.htt-disk-one:checked');
        const allChecked = cb.querySelector('.htt-disk-all').checked;
        const disks = allChecked ? ['all'] : Array.from(diskChecks).map(c => c.value);
        const joinEl = cb.querySelector('.htt-cond-join');
        return {
            trigger_type: cb.querySelector('.htt-cond-trigger-type').value,
            disks: disks,
            aggregate: cb.querySelector('.htt-cond-aggregate').value,
            direction: cb.querySelector('.htt-cond-direction').value,
            threshold: parseFloat(cb.querySelector('.htt-cond-threshold').value),
            join: ci > 0 ? (joinEl ? joinEl.value : 'and') : 'and',
        };
    });
    return {
        id: orig.id || httUid(),
        name: box.querySelector('.htt-name').value || 'Rule',
        enabled: box.querySelector('.htt-enabled').checked,
        conditions: conditions,
        delay_seconds: parseFloat(box.querySelector('.htt-delay').value) || 0,
        force_resend: box.querySelector('.htt-force-resend').checked,
        reset_rules: Array.from(box.querySelectorAll('.htt-reset-rules-one:checked')).map(c => c.value),
        protocol: box.querySelector('.htt-protocol').value,
        http: {
            state: box.querySelector('.htt-http-state').value,
            connection_id: box.querySelector('.htt-http-conn').value,
            base_url: box.querySelector('.htt-http-url').value,
            device_index: box.querySelector('.htt-http-idx').value,
            username: box.querySelector('.htt-http-user').value,
            password: box.querySelector('.htt-http-pass').value,
        },
        mqtt: {
            connection_id: box.querySelector('.htt-mqtt-conn').value,
            host: box.querySelector('.htt-mqtt-host').value,
            port: parseInt(box.querySelector('.htt-mqtt-port').value) || 1883,
            tls: box.querySelector('.htt-mqtt-tls').checked,
            insecure_tls: box.querySelector('.htt-mqtt-insecure').checked,
            username: box.querySelector('.htt-mqtt-user').value,
            password: box.querySelector('.htt-mqtt-pass').value,
            topic: box.querySelector('.htt-mqtt-topic').value,
            payload: box.querySelector('.htt-mqtt-payload').value,
            state_topic: box.querySelector('.htt-mqtt-statetopic').value,
            state_is_json: box.querySelector('.htt-mqtt-statejson').checked,
            state_json_key: box.querySelector('.htt-mqtt-statekey').value || 'state',
            state_on_value: box.querySelector('.htt-mqtt-state-on').value || 'ON',
            state_off_value: box.querySelector('.htt-mqtt-state-off').value || 'OFF',
        },
        webhook: {
            connection_id: box.querySelector('.htt-webhook-conn').value,
            method: box.querySelector('.htt-webhook-method').value,
            url: box.querySelector('.htt-webhook-url').value,
            body: box.querySelector('.htt-webhook-body').value,
            headers: box.querySelector('.htt-webhook-headers').value,
            username: box.querySelector('.htt-webhook-user').value,
            password: box.querySelector('.htt-webhook-pass').value,
            insecure_tls: box.querySelector('.htt-webhook-insecure').checked,
            state_url: box.querySelector('.htt-webhook-state-url').value,
            state_method: box.querySelector('.htt-webhook-state-method').value,
        },
    };
}

function httCollectRules() {
    const boxes = document.querySelectorAll('#htt-rules .rule-box');
    const rules = [];
    boxes.forEach(box => {
        const i = parseInt(box.dataset.index);
        rules.push(httCollectRuleFromBox(box, httRules[i]));
    });
    httRules = rules;
    return rules;
}

function httSnapshotRules(rules) {
    rules.forEach(r => { if (r.id) httRuleSnapshots[r.id] = JSON.stringify(r); });
}

function httUpdateRuleDirtyIndicator(box) {
    const rule = httCollectRuleFromBox(box, { id: box.dataset.ruleId });
    const btn = box.querySelector('.htt-rule-header-save');
    if (!btn) return;
    const dirty = httRuleSnapshots[rule.id] !== JSON.stringify(rule);
    btn.style.display = dirty ? '' : 'none';
}

function httSaveRule(i) {
    httCollectRules();
    const rule = httRules[i];
    const box = document.querySelector(`#htt-rules .rule-box[data-index="${i}"]`);
    const msgEl = box?.querySelector('.htt-rule-save-msg');
    httPost('action=save_rule&rule=' + encodeURIComponent(JSON.stringify(rule)))
        .then(r => r.json()).then(d => {
            if (msgEl) {
                msgEl.textContent = d.ok ? ' Saved and applied.' : ' Error saving: ' + (d.error || 'unknown error');
                setTimeout(() => msgEl.textContent = '', 3000);
            }
            if (d.ok) {
                httSnapshotRules([rule]);
                if (box) httUpdateRuleDirtyIndicator(box);
            }
        }).catch(err => {
            if (msgEl) msgEl.textContent = ' Error saving: ' + err;
        });
}

function httTestRule(i) {
    httCollectRules();
    const rule = httRules[i];
    const box = document.querySelector(`#htt-rules .rule-box[data-index="${i}"]`);
    const msgEl = box?.querySelector('.htt-rule-test-msg');
    if (msgEl) { msgEl.textContent = 'Sending...'; msgEl.style.color = ''; }
    httPost('action=test_command&rule=' + encodeURIComponent(JSON.stringify(rule)))
        .then(r => r.json()).then(d => {
            if (!msgEl) return;
            msgEl.textContent = d.ok ? 'Command sent successfully.' : 'Command failed - check log.';
            msgEl.style.color = d.ok ? '#2ea043' : '#cf5b5b';
            setTimeout(() => { msgEl.textContent = ''; msgEl.style.color = ''; }, 5000);
        }).catch(err => {
            if (msgEl) { msgEl.textContent = 'Error: ' + err; msgEl.style.color = '#cf5b5b'; }
        });
}

function httTestConditions(i) {
    httCollectRules();
    const rule = httRules[i];
    const box = document.querySelector(`#htt-rules .rule-box[data-index="${i}"]`);
    const resultsEl = box?.querySelector('.htt-cond-results');
    if (resultsEl) resultsEl.innerHTML = '<div class="row" style="opacity:0.75">Testing...</div>';
    httPost('action=test_conditions&rule=' + encodeURIComponent(JSON.stringify(rule)))
        .then(r => r.json()).then(d => {
            if (!resultsEl) return;
            if (!d.ok) { resultsEl.innerHTML = `<div class="row" style="color:#cf5b5b">Error: ${d.error || 'unknown error'}</div>`; return; }
            const typeLabels = { temp: 'Disk temperature', usage: 'Disk usage %', parity_check: 'Parity check', rebuild: 'Array/data rebuild' };
            let html = '<div style="border:1px solid #555;border-radius:4px;padding:8px;margin-top:6px">';
            d.steps.forEach((s, si) => {
                const label = typeLabels[s.trigger_type] || s.trigger_type;
                const icon = s.met === null ? '?' : (s.met ? '&#10003;' : '&#10007;');
                const color = s.met === null ? '#999' : (s.met ? '#2ea043' : '#cf5b5b');
                const joinPrefix = s.join ? `${s.join.toUpperCase()} ` : '';
                html += `<div class="row" style="color:${color}">${joinPrefix}<b>${icon}</b> ${label}: ${s.reason || 'unavailable'}</div>`;
            });
            html += `<hr style="border:none;border-top:1px solid #666;margin:8px 0">`;
            html += `<div class="row" style="color:${d.overall?'#2ea043':'#cf5b5b'}"><b>Overall: ${d.overall ? 'TRUE - would fire' : 'FALSE - would not fire'}</b></div>`;
            html += '</div>';
            resultsEl.innerHTML = html;
        }).catch(err => {
            if (resultsEl) resultsEl.innerHTML = `<div class="row" style="color:#cf5b5b">Error: ${err}</div>`;
        });
}

function httCheckState(i) {
    httCollectRules();
    const rule = httRules[i];
    const box = document.querySelector(`#htt-rules .rule-box[data-index="${i}"]`);
    const resultsEl = box?.querySelector('.htt-checkstate-results');
    if (resultsEl) resultsEl.innerHTML = '<div class="row" style="opacity:0.75">Checking...</div>';
    httPost('action=get_device_state&rule=' + encodeURIComponent(JSON.stringify(rule)))
        .then(r => r.json()).then(d => {
            if (!resultsEl) return;
            if (!d.ok) {
                resultsEl.innerHTML = `<div class="row" style="color:#cf5b5b">Could not read device state: ${d.error || 'unknown error'}</div>`;
                return;
            }
            const stateStr = d.state ? d.state.toUpperCase() : 'unrecognized';
            resultsEl.innerHTML = `
                <div style="border:1px solid #555;border-radius:4px;padding:8px;margin-top:6px">
                    <div class="row"><b>Device reports:</b> ${stateStr}</div>
                    <div class="row" style="opacity:0.75;word-break:break-all">Raw: ${String(d.raw).replace(/</g,'&lt;')}</div>
                    <div class="row" style="opacity:0.75">(internal tracked state has been synced to match, where applicable)</div>
                </div>
            `;
            httLoadStatus();
        }).catch(err => {
            if (resultsEl) resultsEl.innerHTML = `<div class="row" style="color:#cf5b5b">Error: ${err}</div>`;
        });
}

function httServiceControl(cmd) {
    httPost('action=service_control&cmd=' + cmd).then(() => setTimeout(httLoadStatus, 1500));
}

function httToggleYaml() {
    const ta = document.getElementById('htt-yaml-view');
    const isOpen = ta.style.display !== 'none';
    if (isOpen) {
        ta.style.display = 'none';
        document.getElementById('htt-yaml-download').style.display = 'none';
        document.getElementById('htt-yaml-apply').style.display = 'none';
        document.getElementById('htt-yaml-msg').textContent = '';
        document.getElementById('htt-yaml-toggle').textContent = 'View as YAML';
        return;
    }
    fetch(HTT_ENDPOINT + '?action=get_config_yaml', { credentials: 'same-origin' }).then(r => r.text()).then(yaml => {
        ta.value = yaml;
        ta.style.display = '';
        const link = document.getElementById('htt-yaml-download');
        const blob = new Blob([yaml], { type: 'text/yaml' });
        link.href = URL.createObjectURL(blob);
        link.download = 'unraid-disk-event-trigger.yaml';
        link.style.display = '';
        document.getElementById('htt-yaml-apply').style.display = '';
        document.getElementById('htt-yaml-toggle').textContent = 'Hide YAML';
    });
}

function httApplyYaml() {
    const yaml = document.getElementById('htt-yaml-view').value;
    const msg = document.getElementById('htt-yaml-msg');
    msg.textContent = ' Validating...';
    httPost('action=save_config_yaml&yaml=' + encodeURIComponent(yaml))
        .then(r => r.json()).then(d => {
            if (d.ok) {
                msg.textContent = ' Applied.';
                setTimeout(() => msg.textContent = '', 3000);
                // Refresh the rule editor / global settings from the newly saved config.
                fetch(HTT_ENDPOINT + '?action=get_config', { credentials: 'same-origin' }).then(r => r.json()).then(config => {
                    httRules = (config.rules || []).map(httNormalizeRule);
                    httRulesStructureDirty = false;
                    httConnections = config.connections || [];
                    document.getElementById('htt-poll-interval').value = config.poll_interval ?? 60;
                    const pluginEnabled = document.getElementById('htt-plugin-enabled');
                    pluginEnabled.checked = config.enabled ?? true;
                    const box = document.getElementById('htt-plugin-toggle');
                    box.classList.remove('enabled', 'disabled');
                    box.classList.add(pluginEnabled.checked ? 'enabled' : 'disabled');
                    httCollapsedOverride = {};
                    httRenderConnections();
                    httRenderRules();
                    // Re-collect through the DOM so the snapshot is in the same
                    // canonical shape httCollectRuleFromBox() produces later.
                    httRules = httCollectRules();
                    httSnapshotRules(httRules);
                    httRenderRules();
                    httUpdateRulesStructureButton();
                    httLoadStatus();
                });
            } else {
                msg.textContent = ' Not applied - ' + (d.error || 'unknown error');
            }
        }).catch(err => {
            msg.textContent = ' Not applied - ' + err;
        });
}

let httNextCycleAtMs = null; // epoch ms, resynced from the server every httLoadStatus() poll
let httServiceRunning = false;

/** Ticks every second between httLoadStatus() polls so the countdown doesn't visibly jump/stall. */
function httUpdateNextCycleDisplay() {
    const el = document.getElementById('htt-next-cycle');
    if (!el) return;
    if (!httServiceRunning) { el.textContent = ''; return; }
    if (!httNextCycleAtMs) { el.textContent = 'Next poll cycle: waiting for the first cycle to run...'; return; }
    const remaining = Math.round((httNextCycleAtMs - Date.now()) / 1000);
    el.textContent = remaining > 0 ? `Next poll cycle in ${remaining}s` : 'Poll cycle running...';
}

function httLoadStatus() {
    fetch(HTT_ENDPOINT + '?action=get_status', { credentials: 'same-origin' }).then(r => r.json()).then(d => {
        document.getElementById('htt-service-status').textContent = d.service_status;
        httServiceRunning = !!d.running;
        const lastCycleAt = (d.state && d.state._last_cycle_at) || null;
        httNextCycleAtMs = (httServiceRunning && lastCycleAt) ? (lastCycleAt + (d.poll_interval || 60)) * 1000 : null;
        httUpdateNextCycleDisplay();
        const a = d.array || {};
        document.getElementById('htt-array-status').textContent = a.active
            ? `Array operation in progress: ${a.action} (parity check: ${a.is_parity_check}, rebuild: ${a.is_rebuild})`
            : 'No parity check / rebuild in progress.';
        const tbody = document.getElementById('htt-disk-table');
        tbody.innerHTML = '';
        d.disks.forEach(disk => {
            tbody.innerHTML += `<tr><td>${disk.name}</td><td>${disk.device}</td><td>${disk.spundown?'yes':'no'}</td><td>${disk.spundown?'-':(disk.live_temp ?? '?')}</td><td>${disk.usage_pct ?? '?'}</td></tr>`;
        });
        httLastState = d.state || {};
        document.querySelectorAll('.htt-relay-badge').forEach(badge => {
            const s = httLastState[badge.dataset.ruleId];
            const fired = !!(s && s.fired);
            badge.classList.toggle('on', fired);
            badge.textContent = fired ? 'Fired' : 'Idle';
        });
    });
}

function httLoadLog() {
    fetch(HTT_ENDPOINT + '?action=get_log', { credentials: 'same-origin' }).then(r => r.json()).then(d => {
        document.getElementById('htt-log').innerHTML = '<div id="htt-status">' + (d.log || '(empty)').replace(/</g,'&lt;') + '</div>';
    });
}

function httClearLog() {
    if (!confirm('Clear the log?')) return;
    httPost('action=clear_log').then(r => r.json()).then(() => httLoadLog());
}

httRenderConnections();
httRenderRules();
// Re-collect once through the DOM so the "as saved" snapshot is in the same
// canonical shape httCollectRuleFromBox() produces later - otherwise every
// rule would show as dirty on load just from key-order/shape differences
// versus the raw JSON straight off disk.
httRules = httCollectRules();
httSnapshotRules(httRules);
httRenderRules();
httLoadStatus();
httLoadLog();
setInterval(httLoadStatus, 15000);
setInterval(httUpdateNextCycleDisplay, 1000);
</script>
