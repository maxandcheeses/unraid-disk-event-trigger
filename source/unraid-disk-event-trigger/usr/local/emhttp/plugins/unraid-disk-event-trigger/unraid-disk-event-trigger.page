<script>
const HTT_DISKS = <?= json_encode(array_values($disks)) ?>;
/** ruleId -> JSON snapshot of the rule as last saved to disk, used to show/hide each rule's header Save button. */
let httRuleSnapshots = {};
let httRules = <?= json_encode($config['rules']) ?>.map(httNormalizeRule);
let httConnections = <?= json_encode($config['connections'] ?? []) ?>;
let httLastState = {}; // ruleId -> {fired, last_value, ...}, cached across re-renders so folding doesn't blank the badge
const HTT_CSRF = '<?= htmlspecialchars($var['csrf_token'] ?? '', ENT_QUOTES) ?>';

/**
 * Rules saved before multi-condition support stored a single condition
 * inline (trigger_type/disks/aggregate/direction/threshold). Rules saved
 * before the rule-level Action dropdown was removed also stored a single
 * on/off action_direction, which only ever mattered for Tasmota HTTP's
 * Power On/Off command - migrate it into http.state so old HTTP rules keep
 * sending the same command; MQTT/webhook rules already fully described
 * their own command via topic+payload / URL+body and don't need it.
 */
function httNormalizeRule(rule) {
    if (!rule.conditions || !rule.conditions.length) {
        rule.conditions = [{
            trigger_type: rule.trigger_type || 'temp',
            disks: rule.disks || ['all'],
            aggregate: rule.aggregate || 'max',
            direction: rule.direction || 'on',
            threshold: rule.threshold ?? 40,
        }];
    }
    rule.http = rule.http || {};
    if (!rule.http.state) rule.http.state = rule.action_direction || 'on';
    return rule;
}

function httBadgeHtml(rule) {
    const s = httLastState[rule.id];
    const fired = !!(s && s.fired);
    const text = fired ? 'Fired' : 'Idle';
    return `<span class="htt-relay-badge ${fired?'on':''}" data-rule-id="${rule.id||''}">${text}</span>`;
}

/** Direction dropdown option labels, which depend on the trigger type. */
function httDirectionLabels(triggerType) {
    if (triggerType === 'parity_check' || triggerType === 'rebuild') {
        return { on: 'Met while active (including if already running when checked)', off: 'Met while inactive' };
    }
    return { on: 'Met when value is ≥ threshold', off: 'Met when value is ≤ threshold' };
}
const HTT_ENDPOINT = '/plugins/unraid-disk-event-trigger/include/handler.php';

function httPost(body) {
    return fetch(HTT_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        credentials: 'same-origin',
        body: body + '&csrf_token=' + encodeURIComponent(HTT_CSRF),
    });
}

function httUid() { return Math.random().toString(16).slice(2, 10); }

function httPassField(cls, value) {
    const esc = String(value).replace(/"/g, '&quot;');
    return `<span class="htt-pass-wrap"><input type="password" class="${cls}" value="${esc}"><button type="button" class="htt-pass-toggle" title="Show/hide password" onclick="httTogglePass(this)">&#128065;</button></span>`;
}

function httTogglePass(btn) {
    const input = btn.previousElementSibling;
    input.type = input.type === 'password' ? 'text' : 'password';
}

function httResetRulesCheckboxes(rule, i) {
    const selected = rule.reset_rules || [];
    const others = httRules.filter((r, j) => j !== i);
    if (others.length === 0) return '<span style="opacity:0.6">(no other rules to reference)</span>';
    return others.map(r => {
        const checked = selected.includes(r.id) ? 'checked' : '';
        return `<label><input type="checkbox" class="htt-reset-rules-one" value="${r.id}" ${checked}> ${(r.name||'Rule').replace(/</g,'&lt;')}</label><br>`;
    }).join('');
}

function httDiskCheckboxes(selected) {
    selected = selected || ['all'];
    let allChecked = selected.includes('all') ? 'checked' : '';
    let html = `<label><input type="checkbox" class="htt-disk-all" ${allChecked} onchange="this.closest('.disk-list').querySelectorAll('.htt-disk-one').forEach(c=>c.disabled=this.checked)"> All array/cache disks</label><br>`;
    HTT_DISKS.forEach(d => {
        let checked = selected.includes(d.name) ? 'checked' : '';
        let disabled = allChecked ? 'disabled' : '';
        html += `<label><input type="checkbox" class="htt-disk-one" value="${d.name}" ${checked} ${disabled}> ${d.name} (${d.device})</label><br>`;
    });
    return html;
}

/** ruleId:condIndex -> bool, only set once the user explicitly toggles a condition */
let httCondCollapsedOverride = {};

function httCondSummary(cond) {
    const triggerType = cond.trigger_type || 'temp';
    const direction = cond.direction === 'off' ? 'off' : 'on';
    if (triggerType === 'parity_check' || triggerType === 'rebuild') {
        const label = triggerType === 'parity_check' ? 'Parity check' : 'Array/data rebuild';
        return `${label} ${direction === 'off' ? 'inactive' : 'active'}`;
    }
    const label = triggerType === 'usage' ? 'Disk usage' : 'Disk temp';
    const unit = triggerType === 'usage' ? '%' : '°C';
    const cmp = direction === 'off' ? '&#8804;' : '&#8805;';
    return `${label} ${cmp} ${cond.threshold ?? 40}${unit}`;
}

function httConditionBlock(cond, ruleIndex, condIndex, totalConditions, ruleId) {
    const triggerType = cond.trigger_type || 'temp';
    const isMetric = triggerType === 'temp' || triggerType === 'usage';
    const unit = triggerType === 'usage' ? '%' : '°C';
    const dirLabels = httDirectionLabels(triggerType);
    const direction = cond.direction === 'off' ? 'off' : 'on';
    const join = cond.join === 'or' ? 'or' : 'and';
    const key = (ruleId || 'idx' + ruleIndex) + ':' + condIndex;
    const collapsed = key in httCondCollapsedOverride ? httCondCollapsedOverride[key] : (totalConditions > 1);
    return `
        <div class="htt-cond-block" style="border:1px solid #555;border-radius:4px;padding:8px;margin-bottom:6px">
            ${condIndex > 0 ? `<div class="row" style="margin-bottom:6px"><select class="htt-cond-join"><option value="and" ${join==='or'?'':'selected'}>AND</option><option value="or" ${join==='or'?'selected':''}>OR</option></select> <span style="opacity:0.75">this condition with the running result above</span></div>` : ''}
            <div class="row" style="margin-bottom:6px">
                <span class="htt-rule-toggle" onclick="httToggleCondCollapse('${ruleId||''}',${ruleIndex},${condIndex})">${collapsed ? '&#9656;' : '&#9662;'}</span>
                ${collapsed ? `<span style="opacity:0.85">${httCondSummary(cond)}</span>` : `
                <select class="htt-cond-trigger-type" onchange="httToggleCondTriggerType(this)">
                    <option value="temp" ${triggerType==='temp'?'selected':''}>Disk temperature</option>
                    <option value="usage" ${triggerType==='usage'?'selected':''}>Disk usage %</option>
                    <option value="parity_check" ${triggerType==='parity_check'?'selected':''}>Parity check</option>
                    <option value="rebuild" ${triggerType==='rebuild'?'selected':''}>Array/data rebuild</option>
                </select>`}
                <button type="button" onclick="httDuplicateCondition(${ruleIndex},${condIndex})" style="margin-left:8px">Duplicate condition</button>
                ${totalConditions > 1 ? `<button type="button" onclick="httRemoveCondition(${ruleIndex},${condIndex})" style="margin-left:8px">Remove condition</button>` : ''}
            </div>
            <div class="htt-cond-body" style="display:${collapsed?'none':''}">
            ${collapsed ? `<select class="htt-cond-trigger-type" style="display:none">
                    <option value="temp" ${triggerType==='temp'?'selected':''}>Disk temperature</option>
                    <option value="usage" ${triggerType==='usage'?'selected':''}>Disk usage %</option>
                    <option value="parity_check" ${triggerType==='parity_check'?'selected':''}>Parity check</option>
                    <option value="rebuild" ${triggerType==='rebuild'?'selected':''}>Array/data rebuild</option>
                </select>` : ''}
            <div class="row htt-cond-disks-row" style="display:${isMetric?'':'none'}">
                <label>Disks</label>
                <div class="disk-list">${httDiskCheckboxes(cond.disks)}</div>
            </div>
            <div class="row htt-cond-aggregate-row" style="display:${isMetric?'':'none'}">
                <label>Aggregate</label>
                <select class="htt-cond-aggregate">
                    <option value="max" ${cond.aggregate==='max'?'selected':''}>Max (${triggerType==='usage'?'fullest':'hottest'} disk)</option>
                    <option value="avg" ${cond.aggregate==='avg'?'selected':''}>Average</option>
                    <option value="min" ${cond.aggregate==='min'?'selected':''}>Min (${triggerType==='usage'?'emptiest':'coolest'} disk)</option>
                </select>
            </div>
            <div class="row">
                <label>Condition</label>
                <select class="htt-cond-direction">
                    <option value="on" ${direction==='off'?'':'selected'}>${dirLabels.on}</option>
                    <option value="off" ${direction==='off'?'selected':''}>${dirLabels.off}</option>
                </select>
            </div>
            <div class="row htt-cond-threshold-row" style="display:${isMetric?'':'none'}">
                <label>Threshold</label>
                <input type="number" class="htt-cond-threshold" value="${cond.threshold ?? 40}"> <span class="htt-cond-threshold-unit">${unit}</span>
            </div>
            </div>
        </div>
    `;
}

function httToggleCondCollapse(ruleId, ruleIndex, condIndex) {
    httCollectRules(); // otherwise re-rendering would discard unsaved edits elsewhere
    const key = (ruleId || 'idx' + ruleIndex) + ':' + condIndex;
    const totalConditions = (httRules[ruleIndex]?.conditions || []).length;
    const currentlyCollapsed = key in httCondCollapsedOverride ? httCondCollapsedOverride[key] : (totalConditions > 1);
    httCondCollapsedOverride[key] = !currentlyCollapsed;
    httRenderRules();
}

function httToggleCondTriggerType(sel) {
    const block = sel.closest('.htt-cond-block');
    const type = sel.value;
    const isMetric = type === 'temp' || type === 'usage';
    const isUsage = type === 'usage';
    block.querySelector('.htt-cond-disks-row').style.display = isMetric ? '' : 'none';
    block.querySelector('.htt-cond-aggregate-row').style.display = isMetric ? '' : 'none';
    block.querySelector('.htt-cond-threshold-row').style.display = isMetric ? '' : 'none';
    block.querySelector('.htt-cond-threshold-unit').textContent = isUsage ? '%' : '°C';
    const aggSel = block.querySelector('.htt-cond-aggregate');
    aggSel.querySelector('option[value="max"]').textContent = `Max (${isUsage ? 'fullest' : 'hottest'} disk)`;
    aggSel.querySelector('option[value="min"]').textContent = `Min (${isUsage ? 'emptiest' : 'coolest'} disk)`;
    const dirLabels = httDirectionLabels(type);
    const dirSel = block.querySelector('.htt-cond-direction');
    dirSel.querySelector('option[value="on"]').textContent = dirLabels.on;
    dirSel.querySelector('option[value="off"]').textContent = dirLabels.off;
}

function httAddCondition(ruleIndex) {
    httCollectRules();
    httRules[ruleIndex].conditions.push({ trigger_type: 'temp', disks: ['all'], aggregate: 'max', direction: 'on', threshold: 40, join: 'and' });
    httRenderRules();
}

function httRemoveCondition(ruleIndex, condIndex) {
    httCollectRules();
    httRules[ruleIndex].conditions.splice(condIndex, 1);
    httRenderRules();
}

function httDuplicateCondition(ruleIndex, condIndex) {
    httCollectRules();
    const conditions = httRules[ruleIndex].conditions;
    const clone = JSON.parse(JSON.stringify(conditions[condIndex]));
    clone.join = 'and'; // the clone is inserted after the original, so it needs its own join (defaults to AND, editable like any other condition)
    conditions.splice(condIndex + 1, 0, clone);
    httRenderRules();
}

function httConnectionOptions(type, selectedId) {
    let html = `<option value="">Custom (enter below)</option>`;
    httConnections.filter(c => c.type === type).forEach(c => {
        html += `<option value="${c.id}" ${c.id === selectedId ? 'selected' : ''}>${(c.name||'').replace(/</g,'&lt;')}</option>`;
    });
    return html;
}

let httConnCollapsedOverride = {}; // connectionId -> bool, only set once the user explicitly toggles a connection

function httRenderConnections() {
    const wrap = document.getElementById('htt-connections');
    wrap.innerHTML = '';
    httConnections.forEach((conn, i) => {
        const key = conn.id || ('idx' + i);
        const collapsed = key in httConnCollapsedOverride ? httConnCollapsedOverride[key] : (httConnections.length > 1);
        const box = document.createElement('div');
        box.className = 'rule-box' + (collapsed ? ' collapsed' : '');
        box.dataset.index = i;
        const type = conn.type || 'mqtt';
        box.innerHTML = `
            <h4>
                <span class="htt-rule-toggle" onclick="httToggleConnCollapse(${i})">${collapsed ? '&#9656;' : '&#9662;'}</span>
                <input type="text" class="htt-conn-name" value="${(conn.name||'').replace(/"/g,'&quot;')}" placeholder="Connection name" style="width:200px">
                <select class="htt-conn-type" onchange="httToggleConnType(this)">
                    <option value="http" ${type==='http'?'selected':''}>Tasmota HTTP</option>
                    <option value="mqtt" ${type==='mqtt'?'selected':''}>MQTT</option>
                    <option value="webhook" ${type==='webhook'?'selected':''}>Generic HTTP/HTTPS webhook</option>
                </select>
                <span class="htt-rule-actions">
                    <button type="button" onclick="httTestConnection(${i})" ${type==='webhook'?'disabled title="Webhook connections have no fixed endpoint of their own to test - test from a rule using this connection instead."':''}>Test</button>
                    <button type="button" onclick="httRemoveConnection(${i})">Remove</button>
                </span>
                <span class="htt-conn-test-msg"></span>
            </h4>
            <div class="rule-body">
            <div class="proto-block htt-conn-http-block ${type==='http'?'active':''}">
                <div class="row"><label>Device base URL</label><input type="text" class="htt-conn-http-url" value="${(conn.base_url)||''}" placeholder="http://192.168.1.50"></div>
                <div class="row"><label>Username</label><input type="text" class="htt-conn-http-user" value="${(conn.username)||''}"></div>
                <div class="row"><label>Password</label>${httPassField('htt-conn-http-pass', conn.password||'')}</div>
            </div>
            <div class="proto-block htt-conn-mqtt-block ${type==='mqtt'?'active':''}">
                <div class="row"><label>Broker host</label><input type="text" class="htt-conn-mqtt-host" value="${(conn.host)||''}" placeholder="192.168.1.10"></div>
                <div class="row"><label>Broker port</label><input type="number" class="htt-conn-mqtt-port" value="${(conn.port)||1883}"></div>
                <div class="row"><label style="min-width:auto"><input type="checkbox" class="htt-conn-mqtt-tls" ${conn.tls?'checked':''}> Use TLS (mqtts, typically port 8883)</label></div>
                <div class="row"><label style="min-width:auto"><input type="checkbox" class="htt-conn-mqtt-insecure" ${conn.insecure_tls?'checked':''}> Ignore invalid/self-signed broker certificates</label></div>
                <div class="row"><label>Username</label><input type="text" class="htt-conn-mqtt-user" value="${(conn.username)||''}"></div>
                <div class="row"><label>Password</label>${httPassField('htt-conn-mqtt-pass', conn.password||'')}</div>
            </div>
            <div class="proto-block htt-conn-webhook-block ${type==='webhook'?'active':''}">
                <div class="row"><label>Headers (optional)</label><textarea class="htt-conn-webhook-headers" style="width:320px;height:60px;font-family:monospace;font-size:12px" placeholder="Content-Type: application/json&#10;X-Api-Key: xxxx">${(conn.headers)||''}</textarea></div>
                <div class="row"><label>Username (optional)</label><input type="text" class="htt-conn-webhook-user" value="${(conn.username)||''}"></div>
                <div class="row"><label>Password (optional)</label>${httPassField('htt-conn-webhook-pass', conn.password||'')}</div>
                <div class="row"><label style="min-width:auto"><input type="checkbox" class="htt-conn-webhook-insecure" ${conn.insecure_tls?'checked':''}> Ignore invalid/self-signed HTTPS certificates</label></div>
            </div>
            </div>
        `;
        wrap.appendChild(box);
    });
}

function httToggleConnCollapse(i) {
    httCollectConnections(); // otherwise re-rendering every box would discard unsaved edits in any other connection
    const conn = httConnections[i];
    const key = conn.id || ('idx' + i);
    const currentlyCollapsed = key in httConnCollapsedOverride ? httConnCollapsedOverride[key] : (httConnections.length > 1);
    httConnCollapsedOverride[key] = !currentlyCollapsed;
    httRenderConnections();
}

function httToggleConnType(sel) {
    const box = sel.closest('.rule-box');
    box.querySelector('.htt-conn-http-block').classList.toggle('active', sel.value === 'http');
    box.querySelector('.htt-conn-mqtt-block').classList.toggle('active', sel.value === 'mqtt');
    box.querySelector('.htt-conn-webhook-block').classList.toggle('active', sel.value === 'webhook');
    const testBtn = box.querySelector('.htt-rule-actions button');
    testBtn.disabled = sel.value === 'webhook';
    testBtn.title = sel.value === 'webhook' ? 'Webhook connections have no fixed endpoint of their own to test - test from a rule using this connection instead.' : '';
}

function httAddConnection() {
    httCollectConnections();
    const newConn = { id: httUid(), name: 'New Connection', type: 'mqtt' };
    httConnections.push(newConn);
    httConnCollapsedOverride[newConn.id] = false; // keep the newly added connection open for editing
    httRenderConnections();
}

function httTestConnection(i) {
    const conns = httCollectConnections();
    const conn = conns[i];
    const msgEl = document.querySelectorAll('#htt-connections .rule-box')[i]?.querySelector('.htt-conn-test-msg');
    if (msgEl) msgEl.textContent = ' Testing...';
    httPost('action=test_connection&connection=' + encodeURIComponent(JSON.stringify(conn)))
        .then(r => r.json()).then(d => {
            if (msgEl) {
                msgEl.textContent = d.ok ? ' OK' : ' Failed: ' + (d.error || 'unknown error');
                msgEl.style.color = d.ok ? '#2ea043' : '#cf5b5b';
            }
        }).catch(err => {
            if (msgEl) { msgEl.textContent = ' Failed: ' + err; msgEl.style.color = '#cf5b5b'; }
        });
}

function httRemoveConnection(i) {
    httCollectConnections();
    httConnections.splice(i, 1);
    httRenderConnections();
}

function httCollectConnections() {
    const boxes = document.querySelectorAll('#htt-connections .rule-box');
    const conns = [];
    boxes.forEach(box => {
        const i = parseInt(box.dataset.index);
        const orig = httConnections[i] || {};
        const type = box.querySelector('.htt-conn-type').value;
        const conn = { id: orig.id || httUid(), name: box.querySelector('.htt-conn-name').value || 'Connection', type: type };
        if (type === 'http') {
            conn.base_url = box.querySelector('.htt-conn-http-url').value;
            conn.username = box.querySelector('.htt-conn-http-user').value;
            conn.password = box.querySelector('.htt-conn-http-pass').value;
        } else if (type === 'mqtt') {
            conn.host = box.querySelector('.htt-conn-mqtt-host').value;
            conn.port = parseInt(box.querySelector('.htt-conn-mqtt-port').value) || 1883;
            conn.tls = box.querySelector('.htt-conn-mqtt-tls').checked;
            conn.insecure_tls = box.querySelector('.htt-conn-mqtt-insecure').checked;
            conn.username = box.querySelector('.htt-conn-mqtt-user').value;
            conn.password = box.querySelector('.htt-conn-mqtt-pass').value;
        } else if (type === 'webhook') {
            conn.headers = box.querySelector('.htt-conn-webhook-headers').value;
            conn.username = box.querySelector('.htt-conn-webhook-user').value;
            conn.password = box.querySelector('.htt-conn-webhook-pass').value;
            conn.insecure_tls = box.querySelector('.htt-conn-webhook-insecure').checked;
        }
        conns.push(conn);
    });
    httConnections = conns;
    return conns;
}

function httSaveConnections() {
    const conns = httCollectConnections();
    httPost('action=save_connections&connections=' + encodeURIComponent(JSON.stringify(conns)))
        .then(r => r.json()).then(d => {
            const msg = document.getElementById('htt-connections-save-msg');
            msg.textContent = d.ok ? ' Saved and applied.' : ' Error saving: ' + (d.error || 'unknown error');
            setTimeout(() => msg.textContent = '', 3000);
            httRenderConnections();
            httRenderRules(); // connection names/list shown in rule dropdowns may have changed
        });
}

function httSaveGlobal() {
    const enabled = document.getElementById('htt-plugin-enabled').checked;
    const pollInterval = parseInt(document.getElementById('htt-poll-interval').value) || 60;
    httPost('action=save_global&enabled=' + (enabled ? '1' : '') + '&poll_interval=' + pollInterval)
        .then(r => r.json()).then(d => {
            const msg = document.getElementById('htt-global-save-msg');
            msg.textContent = d.ok ? ' Saved and applied.' : ' Error saving: ' + (d.error || 'unknown error');
            setTimeout(() => msg.textContent = '', 3000);
            const box = document.getElementById('htt-plugin-toggle');
            box.classList.remove('enabled', 'disabled');
            box.classList.add(enabled ? 'enabled' : 'disabled');
        });
}

let httCollapsedOverride = {}; // ruleId -> bool, only set once the user explicitly toggles a rule

function httRenderRules() {
    const wrap = document.getElementById('htt-rules');
    wrap.innerHTML = '';
    httRules.forEach((rule, i) => {
        const key = rule.id || ('idx' + i);
        const collapsed = key in httCollapsedOverride ? httCollapsedOverride[key] : (httRules.length > 1);

