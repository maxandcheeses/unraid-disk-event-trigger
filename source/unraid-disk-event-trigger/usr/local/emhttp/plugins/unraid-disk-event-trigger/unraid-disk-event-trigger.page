<script>
const HTT_DISKS = <?= json_encode(array_values($disks)) ?>;
let httRules = <?= json_encode($config['rules']) ?>.map(httNormalizeRule);
let httConnections = <?= json_encode($config['connections'] ?? []) ?>;
let httLastState = {}; // ruleId -> {fired, last_value, ...}, cached across re-renders so folding doesn't blank the badge
const HTT_CSRF = '<?= htmlspecialchars($var['csrf_token'] ?? '', ENT_QUOTES) ?>';

/**
 * Rules saved before multi-condition support stored a single condition
 * inline (trigger_type/disks/aggregate/direction/threshold) which doubled
 * as the action polarity too. Wrap those into the current conditions[] +
 * action_direction shape so the rest of the UI only deals with one shape.
 */
function httNormalizeRule(rule) {
    if (!rule.conditions || !rule.conditions.length) {
        rule.conditions = [{
            trigger_type: rule.trigger_type || 'temp',
            disks: rule.disks || ['all'],
            aggregate: rule.aggregate || 'max',
            direction: rule.direction || 'on',
            threshold: rule.threshold ?? 40,
        }];
    }
    if (!rule.action_direction) rule.action_direction = rule.direction || 'on';
    return rule;
}

function httBadgeHtml(rule) {
    const s = httLastState[rule.id];
    const dir = rule.action_direction === 'off' ? 'off' : 'on';
    const fired = !!(s && s.fired);
    const cls = fired ? dir : '';
    const text = fired ? `Fired: ${dir.toUpperCase()}` : 'Idle';
    return `<span class="htt-relay-badge ${cls}" data-rule-id="${rule.id||''}" data-direction="${dir}">${text}</span>`;
}

/** Direction dropdown option labels, which depend on the trigger type. */
function httDirectionLabels(triggerType) {
    if (triggerType === 'parity_check' || triggerType === 'rebuild') {
        return { on: 'Turn ON while active (fires immediately if already running)', off: 'Turn OFF while inactive' };
    }
    return { on: 'Turn ON when value rises to ≥ threshold', off: 'Turn OFF when value falls to ≤ threshold' };
}
const HTT_ENDPOINT = '/plugins/unraid-disk-event-trigger/include/handler.php';

function httPost(body) {
    return fetch(HTT_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        credentials: 'same-origin',
        body: body + '&csrf_token=' + encodeURIComponent(HTT_CSRF),
    });
}

function httUid() { return Math.random().toString(16).slice(2, 10); }

function httPassField(cls, value) {
    const esc = String(value).replace(/"/g, '&quot;');
    return `<span class="htt-pass-wrap"><input type="password" class="${cls}" value="${esc}"><button type="button" class="htt-pass-toggle" title="Show/hide password" onclick="httTogglePass(this)">&#128065;</button></span>`;
}

function httTogglePass(btn) {
    const input = btn.previousElementSibling;
    input.type = input.type === 'password' ? 'text' : 'password';
}

function httDiskCheckboxes(selected) {
    selected = selected || ['all'];
    let allChecked = selected.includes('all') ? 'checked' : '';
    let html = `<label><input type="checkbox" class="htt-disk-all" ${allChecked} onchange="this.closest('.disk-list').querySelectorAll('.htt-disk-one').forEach(c=>c.disabled=this.checked)"> All array/cache disks</label><br>`;
    HTT_DISKS.forEach(d => {
        let checked = selected.includes(d.name) ? 'checked' : '';
        let disabled = allChecked ? 'disabled' : '';
        html += `<label><input type="checkbox" class="htt-disk-one" value="${d.name}" ${checked} ${disabled}> ${d.name} (${d.device})</label><br>`;
    });
    return html;
}

function httConditionBlock(cond, ruleIndex, condIndex, totalConditions) {
    const triggerType = cond.trigger_type || 'temp';
    const isMetric = triggerType === 'temp' || triggerType === 'usage';
    const unit = triggerType === 'usage' ? '%' : '°C';
    const dirLabels = httDirectionLabels(triggerType);
    const direction = cond.direction === 'off' ? 'off' : 'on';
    return `
        <div class="htt-cond-block" style="border:1px solid #555;border-radius:4px;padding:8px;margin-bottom:6px">
            <div class="row" style="margin-bottom:6px">
                <select class="htt-cond-trigger-type" onchange="httToggleCondTriggerType(this)">
                    <option value="temp" ${triggerType==='temp'?'selected':''}>Disk temperature</option>
                    <option value="usage" ${triggerType==='usage'?'selected':''}>Disk usage %</option>
                    <option value="parity_check" ${triggerType==='parity_check'?'selected':''}>Parity check</option>
                    <option value="rebuild" ${triggerType==='rebuild'?'selected':''}>Array/data rebuild</option>
                </select>
                ${totalConditions > 1 ? `<button type="button" onclick="httRemoveCondition(${ruleIndex},${condIndex})" style="margin-left:8px">Remove condition</button>` : ''}
            </div>
            <div class="row htt-cond-disks-row" style="display:${isMetric?'':'none'}">
                <label>Disks</label>
                <div class="disk-list">${httDiskCheckboxes(cond.disks)}</div>
            </div>
            <div class="row htt-cond-aggregate-row" style="display:${isMetric?'':'none'}">
                <label>Aggregate</label>
                <select class="htt-cond-aggregate">
                    <option value="max" ${cond.aggregate==='max'?'selected':''}>Max (${triggerType==='usage'?'fullest':'hottest'} disk)</option>
                    <option value="avg" ${cond.aggregate==='avg'?'selected':''}>Average</option>
                    <option value="min" ${cond.aggregate==='min'?'selected':''}>Min (${triggerType==='usage'?'emptiest':'coolest'} disk)</option>
                </select>
            </div>
            <div class="row">
                <label>Condition</label>
                <select class="htt-cond-direction">
                    <option value="on" ${direction==='off'?'':'selected'}>${dirLabels.on}</option>
                    <option value="off" ${direction==='off'?'selected':''}>${dirLabels.off}</option>
                </select>
            </div>
            <div class="row htt-cond-threshold-row" style="display:${isMetric?'':'none'}">
                <label>Threshold</label>
                <input type="number" class="htt-cond-threshold" value="${cond.threshold ?? 40}"> <span class="htt-cond-threshold-unit">${unit}</span>
            </div>
        </div>
    `;
}

function httToggleCondTriggerType(sel) {
    const block = sel.closest('.htt-cond-block');
    const type = sel.value;
    const isMetric = type === 'temp' || type === 'usage';
    const isUsage = type === 'usage';
    block.querySelector('.htt-cond-disks-row').style.display = isMetric ? '' : 'none';
    block.querySelector('.htt-cond-aggregate-row').style.display = isMetric ? '' : 'none';
    block.querySelector('.htt-cond-threshold-row').style.display = isMetric ? '' : 'none';
    block.querySelector('.htt-cond-threshold-unit').textContent = isUsage ? '%' : '°C';
    const aggSel = block.querySelector('.htt-cond-aggregate');
    aggSel.querySelector('option[value="max"]').textContent = `Max (${isUsage ? 'fullest' : 'hottest'} disk)`;
    aggSel.querySelector('option[value="min"]').textContent = `Min (${isUsage ? 'emptiest' : 'coolest'} disk)`;
    const dirLabels = httDirectionLabels(type);
    const dirSel = block.querySelector('.htt-cond-direction');
    dirSel.querySelector('option[value="on"]').textContent = dirLabels.on;
    dirSel.querySelector('option[value="off"]').textContent = dirLabels.off;
}

function httAddCondition(ruleIndex) {
    httCollectRules();
    httRules[ruleIndex].conditions.push({ trigger_type: 'temp', disks: ['all'], aggregate: 'max', direction: 'on', threshold: 40 });
    httRenderRules();
}

function httRemoveCondition(ruleIndex, condIndex) {
    httCollectRules();
    httRules[ruleIndex].conditions.splice(condIndex, 1);
    httRenderRules();
}

function httConnectionOptions(type, selectedId) {
    let html = `<option value="">Custom (enter below)</option>`;
    httConnections.filter(c => c.type === type).forEach(c => {
        html += `<option value="${c.id}" ${c.id === selectedId ? 'selected' : ''}>${(c.name||'').replace(/</g,'&lt;')}</option>`;
    });
    return html;
}

function httRenderConnections() {
    const wrap = document.getElementById('htt-connections');
    wrap.innerHTML = '';
    httConnections.forEach((conn, i) => {
        const box = document.createElement('div');
        box.className = 'rule-box';
        box.dataset.index = i;
        const type = conn.type || 'mqtt';
        box.innerHTML = `
            <h4>
                <input type="text" class="htt-conn-name" value="${(conn.name||'').replace(/"/g,'&quot;')}" placeholder="Connection name" style="width:200px">
                <select class="htt-conn-type" onchange="httToggleConnType(this)">
                    <option value="http" ${type==='http'?'selected':''}>Tasmota HTTP</option>
                    <option value="mqtt" ${type==='mqtt'?'selected':''}>MQTT</option>
                    <option value="webhook" ${type==='webhook'?'selected':''}>Generic HTTP/HTTPS webhook</option>
                </select>
                <span class="htt-rule-actions">
                    <button type="button" onclick="httTestConnection(${i})" ${type==='webhook'?'disabled title="Webhook connections have no fixed endpoint of their own to test - test from a rule using this connection instead."':''}>Test</button>
                    <button type="button" onclick="httRemoveConnection(${i})">Remove</button>
                </span>
                <span class="htt-conn-test-msg"></span>
            </h4>
            <div class="proto-block htt-conn-http-block ${type==='http'?'active':''}">
                <div class="row"><label>Device base URL</label><input type="text" class="htt-conn-http-url" value="${(conn.base_url)||''}" placeholder="http://192.168.1.50"></div>
                <div class="row"><label>Username</label><input type="text" class="htt-conn-http-user" value="${(conn.username)||''}"></div>
                <div class="row"><label>Password</label>${httPassField('htt-conn-http-pass', conn.password||'')}</div>
            </div>
            <div class="proto-block htt-conn-mqtt-block ${type==='mqtt'?'active':''}">
                <div class="row"><label>Broker host</label><input type="text" class="htt-conn-mqtt-host" value="${(conn.host)||''}" placeholder="192.168.1.10"></div>
                <div class="row"><label>Broker port</label><input type="number" class="htt-conn-mqtt-port" value="${(conn.port)||1883}"></div>
                <div class="row"><label style="min-width:auto"><input type="checkbox" class="htt-conn-mqtt-tls" ${conn.tls?'checked':''}> Use TLS (mqtts, typically port 8883)</label></div>
                <div class="row"><label style="min-width:auto"><input type="checkbox" class="htt-conn-mqtt-insecure" ${conn.insecure_tls?'checked':''}> Ignore invalid/self-signed broker certificates</label></div>
                <div class="row"><label>Username</label><input type="text" class="htt-conn-mqtt-user" value="${(conn.username)||''}"></div>
                <div class="row"><label>Password</label>${httPassField('htt-conn-mqtt-pass', conn.password||'')}</div>
            </div>
            <div class="proto-block htt-conn-webhook-block ${type==='webhook'?'active':''}">
                <div class="row"><label>Headers (optional)</label><textarea class="htt-conn-webhook-headers" style="width:320px;height:60px;font-family:monospace;font-size:12px" placeholder="Content-Type: application/json&#10;X-Api-Key: xxxx">${(conn.headers)||''}</textarea></div>
                <div class="row"><label>Username (optional)</label><input type="text" class="htt-conn-webhook-user" value="${(conn.username)||''}"></div>
                <div class="row"><label>Password (optional)</label>${httPassField('htt-conn-webhook-pass', conn.password||'')}</div>
                <div class="row"><label style="min-width:auto"><input type="checkbox" class="htt-conn-webhook-insecure" ${conn.insecure_tls?'checked':''}> Ignore invalid/self-signed HTTPS certificates</label></div>
            </div>
        `;
        wrap.appendChild(box);
    });
}

function httToggleConnType(sel) {
    const box = sel.closest('.rule-box');
    box.querySelector('.htt-conn-http-block').classList.toggle('active', sel.value === 'http');
    box.querySelector('.htt-conn-mqtt-block').classList.toggle('active', sel.value === 'mqtt');
    box.querySelector('.htt-conn-webhook-block').classList.toggle('active', sel.value === 'webhook');
    const testBtn = box.querySelector('.htt-rule-actions button');
    testBtn.disabled = sel.value === 'webhook';
    testBtn.title = sel.value === 'webhook' ? 'Webhook connections have no fixed endpoint of their own to test - test from a rule using this connection instead.' : '';
}

function httAddConnection() {
    httCollectConnections();
    httConnections.push({ id: httUid(), name: 'New Connection', type: 'mqtt' });
    httRenderConnections();
}

function httTestConnection(i) {
    const conns = httCollectConnections();
    const conn = conns[i];
    const msgEl = document.querySelectorAll('#htt-connections .rule-box')[i]?.querySelector('.htt-conn-test-msg');
    if (msgEl) msgEl.textContent = ' Testing...';
    httPost('action=test_connection&connection=' + encodeURIComponent(JSON.stringify(conn)))
        .then(r => r.json()).then(d => {
            if (msgEl) {
                msgEl.textContent = d.ok ? ' OK' : ' Failed: ' + (d.error || 'unknown error');
                msgEl.style.color = d.ok ? '#2ea043' : '#cf5b5b';
            }
        }).catch(err => {
            if (msgEl) { msgEl.textContent = ' Failed: ' + err; msgEl.style.color = '#cf5b5b'; }
        });
}

function httRemoveConnection(i) {
    httCollectConnections();
    httConnections.splice(i, 1);
    httRenderConnections();
}

function httCollectConnections() {
    const boxes = document.querySelectorAll('#htt-connections .rule-box');
    const conns = [];
    boxes.forEach(box => {
        const i = parseInt(box.dataset.index);
        const orig = httConnections[i] || {};
        const type = box.querySelector('.htt-conn-type').value;
        const conn = { id: orig.id || httUid(), name: box.querySelector('.htt-conn-name').value || 'Connection', type: type };
        if (type === 'http') {
            conn.base_url = box.querySelector('.htt-conn-http-url').value;
            conn.username = box.querySelector('.htt-conn-http-user').value;
            conn.password = box.querySelector('.htt-conn-http-pass').value;
        } else if (type === 'mqtt') {
            conn.host = box.querySelector('.htt-conn-mqtt-host').value;
            conn.port = parseInt(box.querySelector('.htt-conn-mqtt-port').value) || 1883;
            conn.tls = box.querySelector('.htt-conn-mqtt-tls').checked;
            conn.insecure_tls = box.querySelector('.htt-conn-mqtt-insecure').checked;
            conn.username = box.querySelector('.htt-conn-mqtt-user').value;
            conn.password = box.querySelector('.htt-conn-mqtt-pass').value;
        } else if (type === 'webhook') {
            conn.headers = box.querySelector('.htt-conn-webhook-headers').value;
            conn.username = box.querySelector('.htt-conn-webhook-user').value;
            conn.password = box.querySelector('.htt-conn-webhook-pass').value;
            conn.insecure_tls = box.querySelector('.htt-conn-webhook-insecure').checked;
        }
        conns.push(conn);
    });
    httConnections = conns;
    return conns;
}

function httSaveConnections() {
    const conns = httCollectConnections();
    httPost('action=save_connections&connections=' + encodeURIComponent(JSON.stringify(conns)))
        .then(r => r.json()).then(d => {
            const msg = document.getElementById('htt-connections-save-msg');
            msg.textContent = d.ok ? ' Saved and applied.' : ' Error saving: ' + (d.error || 'unknown error');
            setTimeout(() => msg.textContent = '', 3000);
            httRenderConnections();
            httRenderRules(); // connection names/list shown in rule dropdowns may have changed
        });
}

function httSaveGlobal() {
    const enabled = document.getElementById('htt-plugin-enabled').checked;
    const pollInterval = parseInt(document.getElementById('htt-poll-interval').value) || 60;
    httPost('action=save_global&enabled=' + (enabled ? '1' : '') + '&poll_interval=' + pollInterval)
        .then(r => r.json()).then(d => {
            const msg = document.getElementById('htt-global-save-msg');
            msg.textContent = d.ok ? ' Saved and applied.' : ' Error saving: ' + (d.error || 'unknown error');
            setTimeout(() => msg.textContent = '', 3000);
            const box = document.getElementById('htt-plugin-toggle');
            box.classList.remove('enabled', 'disabled');
            box.classList.add(enabled ? 'enabled' : 'disabled');
        });
}

let httCollapsedOverride = {}; // ruleId -> bool, only set once the user explicitly toggles a rule

function httRenderRules() {
    const wrap = document.getElementById('htt-rules');
    wrap.innerHTML = '';
    httRules.forEach((rule, i) => {
        const key = rule.id || ('idx' + i);
        const collapsed = key in httCollapsedOverride ? httCollapsedOverride[key] : (httRules.length > 1);

        const direction = rule.action_direction === 'off' ? 'off' : 'on';

        const box = document.createElement('div');
        box.className = 'rule-box' + (collapsed ? ' collapsed' : '');
        box.dataset.index = i;
        box.innerHTML = `
            <h4>
                <span class="htt-rule-toggle" onclick="httToggleCollapse(${i})">${collapsed ? '&#9656;' : '&#9662;'}</span>
                <label class="htt-enabled-label"><input type="checkbox" ${rule.enabled ? 'checked' : ''} class="htt-enabled"> Enabled</label>
                <input type="text" class="htt-name" value="${(rule.name||'').replace(/"/g,'&quot;')}" placeholder="Rule name" style="width:200px">
                ${httBadgeHtml(rule)}
                <span class="htt-rule-actions">
                    <button type="button" onclick="httMoveRule(${i},-1)" ${i===0?'disabled':''} title="Move up (rules run in this order)">&#8593;</button>
                    <button type="button" onclick="httMoveRule(${i},1)" ${i===httRules.length-1?'disabled':''} title="Move down (rules run in this order)">&#8595;</button>
                    <button type="button" onclick="httDuplicateRule(${i})">Duplicate</button>
                    <button type="button" onclick="httTestRule(${i})" title="Fires this rule's configured action once, regardless of current temp/usage/array state">Test</button>
                    <button type="button" onclick="httRemoveRule(${i})">Remove</button>
                </span>
            </h4>
            <div class="rule-body">
            <div class="row" style="opacity:0.75">Conditions <span class="htt-help" title="This rule only fires once ALL of the conditions below are true at the same time (AND) - e.g. 'disk temp &#8804; 35C' AND 'no parity check/rebuild active', so a temperature-driven fan-off doesn't fight a separate 'keep the fan on during parity check' rule over the same relay.">&#9432;</span></div>
            <div class="htt-conditions">${rule.conditions.map((cond, ci) => httConditionBlock(cond, i, ci, rule.conditions.length)).join('')}</div>
            <div class="row"><button type="button" onclick="httAddCondition(${i})">+ Add Condition (AND)</button></div>
            <hr style="border:none;border-top:1px solid #666;margin:12px 0">
            <div class="row">
                <label>Action</label>
                <select class="htt-action-direction">
                    <option value="on" ${direction==='off'?'':'selected'}>Turn ON</option>
                    <option value="off" ${direction==='off'?'selected':''}>Turn OFF</option>
                </select>
                <span class="htt-help" title="What the protocol action below does once all conditions above are simultaneously true.">&#9432;</span>
            </div>
            <div class="row">
                <label>Delay</label>
                <input type="number" class="htt-delay" min="0" style="width:70px" value="${rule.delay_seconds ?? 0}"> sec <span class="htt-help" title="Only fire once the conditions have held continuously (all at once) for this many seconds. If they revert before the delay elapses, the action is never sent. 0 = fire immediately.">&#9432;</span>
            </div>
            <hr style="border:none;border-top:1px solid #666;margin:12px 0">
            <div class="row">
                <label>Force resend</label>
                <label style="min-width:auto"><input type="checkbox" class="htt-force-resend" ${rule.force_resend?'checked':''}> re-send this action every poll cycle while the conditions hold, even after it's already fired</label>
            </div>
            <div class="row">
                <label>Protocol</label>
                <select class="htt-protocol" onchange="httToggleProto(this)">
                    <option value="http" ${rule.protocol!=='mqtt'&&rule.protocol!=='webhook'?'selected':''}>Tasmota HTTP</option>
                    <option value="mqtt" ${rule.protocol==='mqtt'?'selected':''}>MQTT (Tasmota or zigbee2mqtt)</option>
                    <option value="webhook" ${rule.protocol==='webhook'?'selected':''}>Generic HTTP/HTTPS webhook</option>
                </select>
            </div>
            <div class="proto-block htt-http-block ${rule.protocol!=='mqtt'&&rule.protocol!=='webhook'?'active':''}">
                <div class="row"><label>Connection</label><select class="htt-http-conn" onchange="httToggleRuleConn(this)">${httConnectionOptions('http', rule.http?.connection_id||'')}</select></div>
                <div class="htt-http-connfields" style="display:${rule.http?.connection_id?'none':''}">
                <div class="row"><label>Device base URL</label><input type="text" class="htt-http-url" value="${(rule.http?.base_url)||''}" placeholder="http://192.168.1.50"></div>
                <div class="row"><label>Username</label><input type="text" class="htt-http-user" value="${(rule.http?.username)||''}"></div>
                <div class="row"><label>Password</label>${httPassField('htt-http-pass', (rule.http?.password)||'')}</div>
                </div>
                <div class="row"><label>Relay index (optional)</label><input type="text" class="htt-http-idx" value="${(rule.http?.device_index)||''}" placeholder="e.g. 2 for Power2"></div>
                <div class="row"><button type="button" onclick="httCheckState(${i})">Check Device State</button></div>
            </div>
            <div class="proto-block htt-mqtt-block ${rule.protocol==='mqtt'?'active':''}">
                <div class="row"><label>Connection</label><select class="htt-mqtt-conn" onchange="httToggleRuleConn(this)">${httConnectionOptions('mqtt', rule.mqtt?.connection_id||'')}</select></div>
                <div class="htt-mqtt-connfields" style="display:${rule.mqtt?.connection_id?'none':''}">
                <div class="row"><label>Broker host</label><input type="text" class="htt-mqtt-host" value="${(rule.mqtt?.host)||''}" placeholder="192.168.1.10"></div>
                <div class="row"><label>Broker port</label><input type="number" class="htt-mqtt-port" value="${(rule.mqtt?.port)||1883}"></div>
                <div class="row"><label style="min-width:auto"><input type="checkbox" class="htt-mqtt-tls" ${rule.mqtt?.tls?'checked':''}> Use TLS (mqtts, typically port 8883)</label></div>
                <div class="row"><label style="min-width:auto"><input type="checkbox" class="htt-mqtt-insecure" ${rule.mqtt?.insecure_tls?'checked':''}> Ignore invalid/self-signed broker certificates</label> <span class="htt-help" title="Skips TLS certificate verification for this broker. Only enable for trusted LAN brokers with self-signed certs - this disables protection against man-in-the-middle attacks.">&#9432;</span></div>
                <div class="row"><label>Username</label><input type="text" class="htt-mqtt-user" value="${(rule.mqtt?.username)||''}"></div>
                <div class="row"><label>Password</label>${httPassField('htt-mqtt-pass', (rule.mqtt?.password)||'')}</div>
                </div>
                <div class="row"><label>Topic</label><input type="text" class="htt-mqtt-topic" value="${(rule.mqtt?.topic)||''}" placeholder="cmnd/tasmota_xx/POWER  or  zigbee2mqtt/plug/set"></div>
                <div class="row"><label>Payload</label><input type="text" class="htt-mqtt-payload" value="${(rule.mqtt?.payload)||(direction==='off'?'OFF':'ON')}"></div>
                <div class="row"><label>State topic (optional)</label><input type="text" class="htt-mqtt-statetopic" value="${(rule.mqtt?.state_topic)||''}" placeholder="zigbee2mqtt/plug (device's own state topic, not /set)"></div>
                <div class="row"><label>Payload is JSON</label><label style="min-width:auto"><input type="checkbox" class="htt-mqtt-statejson" onchange="this.closest('.row').nextElementSibling.style.display=this.checked?'':'none'" ${rule.mqtt?.state_is_json?'checked':''}> parse as JSON, e.g. zigbee2mqtt's {"state":"ON"} (leave unchecked to compare the raw payload directly)</label></div>
                <div class="row" style="display:${rule.mqtt?.state_is_json?'':'none'}"><label>State JSON key</label><input type="text" class="htt-mqtt-statekey" value="${(rule.mqtt?.state_json_key)||'state'}" placeholder="state"></div>
                <hr style="border:none;border-top:1px solid #666;margin:12px 0">
                <div class="row" style="opacity:0.75">Debug-only: how to interpret the state topic's raw value, used only by "Check Device State".</div>
                <div class="row"><label>Reports ON as</label><input type="text" class="htt-mqtt-state-on" value="${(rule.mqtt?.state_on_value)||'ON'}"></div>
                <div class="row"><label>Reports OFF as</label><input type="text" class="htt-mqtt-state-off" value="${(rule.mqtt?.state_off_value)||'OFF'}"></div>
                <div class="row"><button type="button" onclick="httCheckState(${i})">Check Device State</button></div>
            </div>
            <div class="proto-block htt-webhook-block ${rule.protocol==='webhook'?'active':''}">
                <div class="row"><label>Connection</label><select class="htt-webhook-conn" onchange="httToggleRuleConn(this)">${httConnectionOptions('webhook', rule.webhook?.connection_id||'')}</select></div>
                <div class="row"><label>Method</label>
                    <select class="htt-webhook-method">
                        ${['GET','POST','PUT','PATCH','DELETE'].map(m => `<option value="${m}" ${(rule.webhook?.method||'GET')===m?'selected':''}>${m}</option>`).join('')}
                    </select>
                </div>
                <div class="row"><label>URL</label><input type="text" class="htt-webhook-url" value="${(rule.webhook?.url)||''}" placeholder="https://host/api/toggle"></div>
                <div class="row"><label>Body (optional)</label><input type="text" class="htt-webhook-body" value="${(rule.webhook?.body)||''}" placeholder="raw request body for POST/PUT/PATCH"></div>
                <hr style="border:none;border-top:1px solid #666;margin:12px 0">
                <div class="row" style="opacity:0.75">Shared settings below apply to the action above and the state check.</div>
                <div class="htt-webhook-connfields" style="display:${rule.webhook?.connection_id?'none':''}">
                <div class="row"><label>Headers (optional)</label><textarea class="htt-webhook-headers" style="width:320px;height:60px;font-family:monospace;font-size:12px" placeholder="Content-Type: application/json&#10;X-Api-Key: xxxx">${(rule.webhook?.headers)||''}</textarea></div>
                <div class="row"><label>Username (optional)</label><input type="text" class="htt-webhook-user" value="${(rule.webhook?.username)||''}"></div>
                <div class="row"><label>Password (optional)</label>${httPassField('htt-webhook-pass', (rule.webhook?.password)||'')}</div>
                <div class="row"><label style="min-width:auto"><input type="checkbox" class="htt-webhook-insecure" ${rule.webhook?.insecure_tls?'checked':''}> Ignore invalid/self-signed HTTPS certificates</label> <span class="htt-help" title="Skips TLS certificate verification for this endpoint. Only enable for trusted LAN devices with self-signed certs - this disables protection against man-in-the-middle attacks.">&#9432;</span></div>
                </div>
                <hr style="border:none;border-top:1px solid #666;margin:12px 0">
                <div class="row" style="opacity:0.75">Debug-only: used by "Check Device State" below, not by the action above.</div>
                <div class="row"><label>State URL (optional)</label><input type="text" class="htt-webhook-state-url" value="${(rule.webhook?.state_url)||''}" placeholder="https://host/api/status"></div>
                <div class="row"><label>State method</label>
                    <select class="htt-webhook-state-method">
                        ${['GET','POST','PUT','PATCH','DELETE'].map(m => `<option value="${m}" ${(rule.webhook?.state_method||'GET')===m?'selected':''}>${m}</option>`).join('')}
                    </select>
                </div>
                <div class="row"><button type="button" onclick="httCheckState(${i})">Check Device State</button></div>
            </div>
            <hr style="border:none;border-top:1px solid #666;margin:12px 0">
            <div class="row">
                <button type="button" onclick="httSaveRule(${i})">Save &amp; Apply</button>
                <span class="htt-rule-save-msg"></span>
            </div>
            </div>
        `;
        wrap.appendChild(box);
    });
}

/** Hides a rule's manual connection-level fields (host/user/pass/etc.) once it's tied to a saved connection. */
function httToggleRuleConn(sel) {
    const wrap = sel.closest('.proto-block').querySelector('[class$="-connfields"]');
    if (wrap) wrap.style.display = sel.value ? 'none' : '';
}

function httToggleProto(sel) {
    const box = sel.closest('.rule-box');
    box.querySelector('.htt-http-block').classList.toggle('active', sel.value === 'http');
    box.querySelector('.htt-mqtt-block').classList.toggle('active', sel.value === 'mqtt');
    box.querySelector('.htt-webhook-block').classList.toggle('active', sel.value === 'webhook');
}

function httToggleCollapse(i) {
    httCollectRules(); // otherwise re-rendering every box would discard unsaved edits in any other rule
    const rule = httRules[i];
    const key = rule.id || ('idx' + i);
    const currentlyCollapsed = key in httCollapsedOverride ? httCollapsedOverride[key] : (httRules.length > 1);
    httCollapsedOverride[key] = !currentlyCollapsed;
    httRenderRules();
}

/** Persists the whole rule list/order as-is (used after structural changes below). */
function httSaveRules() {
    return httPost('action=save_rules&rules=' + encodeURIComponent(JSON.stringify(httRules)))
        .then(r => r.json());
}

function httAddRule() {
    httCollectRules(); // otherwise re-rendering every box would discard unsaved edits in any other rule
    const newRule = { id: httUid(), name: 'New Rule', enabled: true, conditions: [{ trigger_type: 'temp', disks: ['all'], aggregate: 'max', direction: 'on', threshold: 40 }], action_direction: 'on', delay_seconds: 0, force_resend: false, protocol: 'http', http: {}, mqtt: {}, webhook: {} };
    httRules.push(newRule);
    httCollapsedOverride[newRule.id] = false; // keep the newly added rule open for editing
    httRenderRules();
    httSaveRules();
}

function httDuplicateRule(i) {
    httCollectRules();
    const clone = JSON.parse(JSON.stringify(httRules[i]));
    clone.id = httUid();
    clone.name = (clone.name || 'Rule') + ' (copy)';
    httRules.splice(i + 1, 0, clone);
    httCollapsedOverride[clone.id] = false; // keep the new copy open for editing
    httRenderRules();
    httSaveRules();
}

function httRemoveRule(i) {
    httCollectRules();
    httRules.splice(i, 1);
    httRenderRules();
    httSaveRules();
}

/** Rules run in this order (top to bottom) - matches poll-cycle execution order 1:1. */
function httMoveRule(i, delta) {
    httCollectRules();
    const j = i + delta;
    if (j < 0 || j >= httRules.length) return;
    [httRules[i], httRules[j]] = [httRules[j], httRules[i]];
    httRenderRules();
    httSaveRules();
}

function httCollectRules() {
    const boxes = document.querySelectorAll('#htt-rules .rule-box');
    const rules = [];
    boxes.forEach(box => {
        const i = parseInt(box.dataset.index);
        const orig = httRules[i] || {};
        const conditions = Array.from(box.querySelectorAll('.htt-cond-block')).map(cb => {
            const diskChecks = cb.querySelectorAll('.htt-disk-one:checked');
            const allChecked = cb.querySelector('.htt-disk-all').checked;
            const disks = allChecked ? ['all'] : Array.from(diskChecks).map(c => c.value);
            return {
                trigger_type: cb.querySelector('.htt-cond-trigger-type').value,
                disks: disks,
                aggregate: cb.querySelector('.htt-cond-aggregate').value,
                direction: cb.querySelector('.htt-cond-direction').value,
                threshold: parseFloat(cb.querySelector('.htt-cond-threshold').value),
            };
        });
        rules.push({
            id: orig.id || httUid(),
            name: box.querySelector('.htt-name').value || 'Rule',
            enabled: box.querySelector('.htt-enabled').checked,
            conditions: conditions,
            action_direction: box.querySelector('.htt-action-direction').value,
            delay_seconds: parseFloat(box.querySelector('.htt-delay').value) || 0,
            force_resend: box.querySelector('.htt-force-resend').checked,
            protocol: box.querySelector('.htt-protocol').value,
            http: {
                connection_id: box.querySelector('.htt-http-conn').value,
                base_url: box.querySelector('.htt-http-url').value,
                device_index: box.querySelector('.htt-http-idx').value,
                username: box.querySelector('.htt-http-user').value,
                password: box.querySelector('.htt-http-pass').value,
            },
            mqtt: {
                connection_id: box.querySelector('.htt-mqtt-conn').value,
                host: box.querySelector('.htt-mqtt-host').value,
                port: parseInt(box.querySelector('.htt-mqtt-port').value) || 1883,
                tls: box.querySelector('.htt-mqtt-tls').checked,
                insecure_tls: box.querySelector('.htt-mqtt-insecure').checked,
                username: box.querySelector('.htt-mqtt-user').value,
                password: box.querySelector('.htt-mqtt-pass').value,
                topic: box.querySelector('.htt-mqtt-topic').value,
                payload: box.querySelector('.htt-mqtt-payload').value,
                state_topic: box.querySelector('.htt-mqtt-statetopic').value,
                state_is_json: box.querySelector('.htt-mqtt-statejson').checked,
                state_json_key: box.querySelector('.htt-mqtt-statekey').value || 'state',
                state_on_value: box.querySelector('.htt-mqtt-state-on').value || 'ON',
                state_off_value: box.querySelector('.htt-mqtt-state-off').value || 'OFF',
            },
            webhook: {
                connection_id: box.querySelector('.htt-webhook-conn').value,
                method: box.querySelector('.htt-webhook-method').value,
                url: box.querySelector('.htt-webhook-url').value,
                body: box.querySelector('.htt-webhook-body').value,
                headers: box.querySelector('.htt-webhook-headers').value,
                username: box.querySelector('.htt-webhook-user').value,
                password: box.querySelector('.htt-webhook-pass').value,
                insecure_tls: box.querySelector('.htt-webhook-insecure').checked,
                state_url: box.querySelector('.htt-webhook-state-url').value,
                state_method: box.querySelector('.htt-webhook-state-method').value,
            },
        });
    });
    httRules = rules;
    return rules;
}

function httSaveRule(i) {
    httCollectRules();
    const rule = httRules[i];
    const msgEl = document.querySelector(`.rule-box[data-index="${i}"] .htt-rule-save-msg`);
    httPost('action=save_rule&rule=' + encodeURIComponent(JSON.stringify(rule)))
        .then(r => r.json()).then(d => {
            if (msgEl) {
                msgEl.textContent = d.ok ? ' Saved and applied.' : ' Error saving: ' + (d.error || 'unknown error');
                setTimeout(() => msgEl.textContent = '', 3000);
            }
        }).catch(err => {
            if (msgEl) msgEl.textContent = ' Error saving: ' + err;
        });
}

function httTestRule(i) {
    httCollectRules();
    const rule = httRules[i];
    httPost('action=test_command&rule=' + encodeURIComponent(JSON.stringify(rule)))
        .then(r => r.json()).then(d => alert(d.ok ? 'Command sent successfully' : 'Command failed - check log'));
}

function httCheckState(i) {
    httCollectRules();
    const rule = httRules[i];
    httPost('action=get_device_state&rule=' + encodeURIComponent(JSON.stringify(rule)))
        .then(r => r.json()).then(d => {
            if (!d.ok) { alert('Could not read device state: ' + (d.error || 'unknown error')); return; }
            const stateStr = d.state ? d.state.toUpperCase() : 'unrecognized';
            alert('Device reports: ' + stateStr + '\nRaw: ' + d.raw + '\n\n(internal tracked state has been synced to match)');
            httLoadStatus();
        });
}

function httServiceControl(cmd) {
    httPost('action=service_control&cmd=' + cmd).then(() => setTimeout(httLoadStatus, 1500));
}

function httToggleYaml() {
    const ta = document.getElementById('htt-yaml-view');
    const isOpen = ta.style.display !== 'none';
    if (isOpen) {
        ta.style.display = 'none';
        document.getElementById('htt-yaml-download').style.display = 'none';
        document.getElementById('htt-yaml-apply').style.display = 'none';
        document.getElementById('htt-yaml-msg').textContent = '';
        document.getElementById('htt-yaml-toggle').textContent = 'View as YAML';
        return;
    }
    fetch(HTT_ENDPOINT + '?action=get_config_yaml', { credentials: 'same-origin' }).then(r => r.text()).then(yaml => {
        ta.value = yaml;
        ta.style.display = '';
        const link = document.getElementById('htt-yaml-download');
        const blob = new Blob([yaml], { type: 'text/yaml' });
        link.href = URL.createObjectURL(blob);
        link.download = 'unraid-disk-event-trigger.yaml';
        link.style.display = '';
        document.getElementById('htt-yaml-apply').style.display = '';
        document.getElementById('htt-yaml-toggle').textContent = 'Hide YAML';
    });
}

function httApplyYaml() {
    const yaml = document.getElementById('htt-yaml-view').value;
    const msg = document.getElementById('htt-yaml-msg');
    msg.textContent = ' Validating...';
    httPost('action=save_config_yaml&yaml=' + encodeURIComponent(yaml))
        .then(r => r.json()).then(d => {
            if (d.ok) {
                msg.textContent = ' Applied.';
                setTimeout(() => msg.textContent = '', 3000);
                // Refresh the rule editor / global settings from the newly saved config.
                fetch(HTT_ENDPOINT + '?action=get_config', { credentials: 'same-origin' }).then(r => r.json()).then(config => {
                    httRules = (config.rules || []).map(httNormalizeRule);
                    httConnections = config.connections || [];
                    document.getElementById('htt-poll-interval').value = config.poll_interval ?? 60;
                    const pluginEnabled = document.getElementById('htt-plugin-enabled');
                    pluginEnabled.checked = config.enabled ?? true;
                    const box = document.getElementById('htt-plugin-toggle');
                    box.classList.remove('enabled', 'disabled');
                    box.classList.add(pluginEnabled.checked ? 'enabled' : 'disabled');
                    httCollapsedOverride = {};
                    httRenderConnections();
                    httRenderRules();
                    httLoadStatus();
                });
            } else {
                msg.textContent = ' Not applied - ' + (d.error || 'unknown error');
            }
        }).catch(err => {
            msg.textContent = ' Not applied - ' + err;
        });
}

function httLoadStatus() {
    fetch(HTT_ENDPOINT + '?action=get_status', { credentials: 'same-origin' }).then(r => r.json()).then(d => {
        document.getElementById('htt-service-status').textContent = d.service_status;
        const a = d.array || {};
        document.getElementById('htt-array-status').textContent = a.active
            ? `Array operation in progress: ${a.action} (parity check: ${a.is_parity_check}, rebuild: ${a.is_rebuild})`
            : 'No parity check / rebuild in progress.';
        const tbody = document.getElementById('htt-disk-table');
        tbody.innerHTML = '';
        d.disks.forEach(disk => {
            tbody.innerHTML += `<tr><td>${disk.name}</td><td>${disk.device}</td><td>${disk.spundown?'yes':'no'}</td><td>${disk.spundown?'-':(disk.live_temp ?? '?')}</td><td>${disk.usage_pct ?? '?'}</td></tr>`;
        });
        httLastState = d.state || {};
        document.querySelectorAll('.htt-relay-badge').forEach(badge => {
            const s = httLastState[badge.dataset.ruleId];
            const dir = badge.dataset.direction === 'off' ? 'off' : 'on';
            badge.classList.remove('on', 'off');
            if (s && s.fired) {
                badge.classList.add(dir);
                badge.textContent = `Fired: ${dir.toUpperCase()}`;
            } else {
                badge.textContent = 'Idle';
            }
        });
    });
}

function httLoadLog() {
    fetch(HTT_ENDPOINT + '?action=get_log', { credentials: 'same-origin' }).then(r => r.json()).then(d => {
        document.getElementById('htt-log').innerHTML = '<div id="htt-status">' + (d.log || '(empty)').replace(/</g,'&lt;') + '</div>';
    });
}

function httClearLog() {
    if (!confirm('Clear the log?')) return;
    httPost('action=clear_log').then(r => r.json()).then(() => httLoadLog());
}

httRenderConnections();
httRenderRules();
httLoadStatus();
httLoadLog();
setInterval(httLoadStatus, 15000);
</script>
