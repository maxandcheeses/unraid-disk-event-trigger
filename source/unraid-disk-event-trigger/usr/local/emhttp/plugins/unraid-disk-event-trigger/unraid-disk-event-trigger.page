<script>
const HTT_DISKS = <?= json_encode(array_values($disks)) ?>;
let httRules = <?= json_encode($config['rules']) ?>;
let httLastState = {}; // ruleId -> {relay, last_temp, ...}, cached across re-renders so folding doesn't blank the badge
const HTT_CSRF = '<?= htmlspecialchars($var['csrf_token'] ?? '', ENT_QUOTES) ?>';

function httBadgeHtml(ruleId) {
    const s = httLastState[ruleId];
    const cls = (s && s.relay) ? s.relay : '';
    const text = (s && s.relay) ? `State: ${s.relay.toUpperCase()}` : 'State: unknown';
    return `<span class="htt-relay-badge ${cls}" data-rule-id="${ruleId||''}">${text}</span>`;
}
const HTT_ENDPOINT = '/plugins/unraid-disk-event-trigger/include/handler.php';

function httPost(body) {
    return fetch(HTT_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        credentials: 'same-origin',
        body: body + '&csrf_token=' + encodeURIComponent(HTT_CSRF),
    });
}

function httUid() { return Math.random().toString(16).slice(2, 10); }

function httPassField(cls, value) {
    const esc = String(value).replace(/"/g, '&quot;');
    return `<span class="htt-pass-wrap"><input type="password" class="${cls}" value="${esc}"><button type="button" class="htt-pass-toggle" title="Show/hide password" onclick="httTogglePass(this)">&#128065;</button></span>`;
}

function httTogglePass(btn) {
    const input = btn.previousElementSibling;
    input.type = input.type === 'password' ? 'text' : 'password';
}

function httDiskCheckboxes(selected) {
    selected = selected || ['all'];
    let allChecked = selected.includes('all') ? 'checked' : '';
    let html = `<label><input type="checkbox" class="htt-disk-all" ${allChecked} onchange="this.closest('.disk-list').querySelectorAll('.htt-disk-one').forEach(c=>c.disabled=this.checked)"> All array/cache disks</label><br>`;
    HTT_DISKS.forEach(d => {
        let checked = selected.includes(d.name) ? 'checked' : '';
        let disabled = allChecked ? 'disabled' : '';
        html += `<label><input type="checkbox" class="htt-disk-one" value="${d.name}" ${checked} ${disabled}> ${d.name} (${d.device})</label><br>`;
    });
    return html;
}

let httCollapsedOverride = {}; // ruleId -> bool, only set once the user explicitly toggles a rule

function httRenderRules() {
    const wrap = document.getElementById('htt-rules');
    wrap.innerHTML = '';
    httRules.forEach((rule, i) => {
        const key = rule.id || ('idx' + i);
        const collapsed = key in httCollapsedOverride ? httCollapsedOverride[key] : (httRules.length > 1);

        const box = document.createElement('div');
        box.className = 'rule-box' + (collapsed ? ' collapsed' : '');
        box.dataset.index = i;
        box.innerHTML = `
            <h4>
                <span class="htt-rule-toggle" onclick="httToggleCollapse(${i})">${collapsed ? '&#9656;' : '&#9662;'}</span>
                <label class="htt-enabled-label"><input type="checkbox" ${rule.enabled ? 'checked' : ''} class="htt-enabled"> Enabled</label>
                <input type="text" class="htt-name" value="${(rule.name||'').replace(/"/g,'&quot;')}" placeholder="Rule name" style="width:200px">
                ${httBadgeHtml(rule.id)}
                <button type="button" onclick="httRemoveRule(${i})" style="float:right">Remove</button>
                <button type="button" onclick="httTestRule(${i}, true)" style="float:right;margin-right:6px">Test ON</button>
                <button type="button" onclick="httTestRule(${i}, false)" style="float:right;margin-right:6px">Test OFF</button>
            </h4>
            <div class="rule-body">
            <div class="row">
                <label>Disks</label>
                <div class="disk-list">${httDiskCheckboxes(rule.disks)}</div>
            </div>
            <div class="row">
                <label>Aggregate</label>
                <select class="htt-aggregate">
                    <option value="max" ${rule.aggregate==='max'?'selected':''}>Max (hottest disk)</option>
                    <option value="avg" ${rule.aggregate==='avg'?'selected':''}>Average</option>
                    <option value="min" ${rule.aggregate==='min'?'selected':''}>Min (coolest disk)</option>
                </select>
            </div>
            <div class="row">
                <label>Turn ON at &ge;</label>
                <input type="number" class="htt-on-temp" value="${rule.on_temp ?? 40}"> &deg;C
            </div>
            <div class="row">
                <label>Turn OFF at &le;</label>
                <input type="number" class="htt-off-temp" value="${rule.off_temp ?? 35}"> &deg;C
            </div>
            <div class="row">
                <label>Also force ON during</label>
                <label style="min-width:auto;margin-right:14px"><input type="checkbox" class="htt-force-parity" ${rule.trigger_on_parity_check?'checked':''}> parity check</label>
                <label style="min-width:auto"><input type="checkbox" class="htt-force-rebuild" ${rule.trigger_on_rebuild?'checked':''}> array/data rebuild</label>
            </div>
            <div class="row">
                <label>Force resend</label>
                <label style="min-width:auto"><input type="checkbox" class="htt-force-resend" ${rule.force_resend?'checked':''}> re-send the ON/OFF command every poll cycle, even if unchanged</label>
            </div>
            <div class="row">
                <label>Protocol</label>
                <select class="htt-protocol" onchange="httToggleProto(this)">
                    <option value="http" ${rule.protocol!=='mqtt'?'selected':''}>Tasmota HTTP</option>
                    <option value="mqtt" ${rule.protocol==='mqtt'?'selected':''}>MQTT (Tasmota or zigbee2mqtt)</option>
                </select>
            </div>
            <div class="proto-block htt-http-block ${rule.protocol!=='mqtt'?'active':''}">
                <div class="row"><label>Device base URL</label><input type="text" class="htt-http-url" value="${(rule.http?.base_url)||''}" placeholder="http://192.168.1.50"></div>
                <div class="row"><label>Relay index (optional)</label><input type="text" class="htt-http-idx" value="${(rule.http?.device_index)||''}" placeholder="e.g. 2 for Power2"></div>
                <div class="row"><label>Username</label><input type="text" class="htt-http-user" value="${(rule.http?.username)||''}"></div>
                <div class="row"><label>Password</label>${httPassField('htt-http-pass', (rule.http?.password)||'')}</div>
                <div class="row"><button type="button" onclick="httCheckState(${i})">Check Device State</button></div>
            </div>
            <div class="proto-block htt-mqtt-block ${rule.protocol==='mqtt'?'active':''}">
                <div class="row"><label>Broker host</label><input type="text" class="htt-mqtt-host" value="${(rule.mqtt?.host)||''}" placeholder="192.168.1.10"></div>
                <div class="row"><label>Broker port</label><input type="number" class="htt-mqtt-port" value="${(rule.mqtt?.port)||1883}"></div>
                <div class="row"><label>Username</label><input type="text" class="htt-mqtt-user" value="${(rule.mqtt?.username)||''}"></div>
                <div class="row"><label>Password</label>${httPassField('htt-mqtt-pass', (rule.mqtt?.password)||'')}</div>
                <div class="row"><button type="button" onclick="httTestMqtt(${i})">Test MQTT Connection</button></div>
                <div class="row"><label>ON topic</label><input type="text" class="htt-mqtt-ontopic" value="${(rule.mqtt?.on_topic)||''}" placeholder="cmnd/tasmota_xx/POWER  or  zigbee2mqtt/plug/set"></div>
                <div class="row"><label>ON payload</label><input type="text" class="htt-mqtt-onpayload" value="${(rule.mqtt?.on_payload)||'ON'}"></div>
                <div class="row"><label>OFF topic</label><input type="text" class="htt-mqtt-offtopic" value="${(rule.mqtt?.off_topic)||''}" placeholder="leave blank to reuse ON topic"></div>
                <div class="row"><label>OFF payload</label><input type="text" class="htt-mqtt-offpayload" value="${(rule.mqtt?.off_payload)||'OFF'}"></div>
                <div class="row"><label>State topic (optional)</label><input type="text" class="htt-mqtt-statetopic" value="${(rule.mqtt?.state_topic)||''}" placeholder="zigbee2mqtt/plug (device's own state topic, not /set)"></div>
                <div class="row"><label>Payload is JSON</label><label style="min-width:auto"><input type="checkbox" class="htt-mqtt-statejson" onchange="this.closest('.row').nextElementSibling.style.display=this.checked?'':'none'" ${rule.mqtt?.state_is_json?'checked':''}> parse as JSON, e.g. zigbee2mqtt's {"state":"ON"} (leave unchecked to compare the raw payload directly)</label></div>
                <div class="row" style="display:${rule.mqtt?.state_is_json?'':'none'}"><label>State JSON key</label><input type="text" class="htt-mqtt-statekey" value="${(rule.mqtt?.state_json_key)||'state'}" placeholder="state"></div>
                <div class="row"><button type="button" onclick="httCheckState(${i})">Check Device State</button></div>
            </div>
            </div>
        `;
        wrap.appendChild(box);
    });
}

function httToggleProto(sel) {
    const box = sel.closest('.rule-box');
    box.querySelector('.htt-http-block').classList.toggle('active', sel.value === 'http');
    box.querySelector('.htt-mqtt-block').classList.toggle('active', sel.value === 'mqtt');
}

function httToggleCollapse(i) {
    const rule = httRules[i];
    const key = rule.id || ('idx' + i);
    const currentlyCollapsed = key in httCollapsedOverride ? httCollapsedOverride[key] : (httRules.length > 1);
    httCollapsedOverride[key] = !currentlyCollapsed;
    httRenderRules();
}

function httAddRule() {
    const newRule = { id: httUid(), name: 'New Rule', enabled: true, disks: ['all'], aggregate: 'max', on_temp: 40, off_temp: 35, trigger_on_parity_check: true, trigger_on_rebuild: true, protocol: 'http', http: {}, mqtt: {} };
    httRules.push(newRule);
    httCollapsedOverride[newRule.id] = false; // keep the newly added rule open for editing
    httRenderRules();
}

function httRemoveRule(i) {
    httCollectRules();
    httRules.splice(i, 1);
    httRenderRules();
}

function httCollectRules() {
    const boxes = document.querySelectorAll('#htt-rules .rule-box');
    const rules = [];
    boxes.forEach(box => {
        const i = parseInt(box.dataset.index);
        const orig = httRules[i] || {};
        const diskChecks = box.querySelectorAll('.htt-disk-one:checked');
        const allChecked = box.querySelector('.htt-disk-all').checked;
        const disks = allChecked ? ['all'] : Array.from(diskChecks).map(c => c.value);
        rules.push({
            id: orig.id || httUid(),
            name: box.querySelector('.htt-name').value || 'Rule',
            enabled: box.querySelector('.htt-enabled').checked,
            disks: disks,
            aggregate: box.querySelector('.htt-aggregate').value,
            on_temp: parseFloat(box.querySelector('.htt-on-temp').value),
            off_temp: parseFloat(box.querySelector('.htt-off-temp').value),
            trigger_on_parity_check: box.querySelector('.htt-force-parity').checked,
            trigger_on_rebuild: box.querySelector('.htt-force-rebuild').checked,
            force_resend: box.querySelector('.htt-force-resend').checked,
            protocol: box.querySelector('.htt-protocol').value,
            http: {
                base_url: box.querySelector('.htt-http-url').value,
                device_index: box.querySelector('.htt-http-idx').value,
                username: box.querySelector('.htt-http-user').value,
                password: box.querySelector('.htt-http-pass').value,
            },
            mqtt: {
                host: box.querySelector('.htt-mqtt-host').value,
                port: parseInt(box.querySelector('.htt-mqtt-port').value) || 1883,
                username: box.querySelector('.htt-mqtt-user').value,
                password: box.querySelector('.htt-mqtt-pass').value,
                on_topic: box.querySelector('.htt-mqtt-ontopic').value,
                on_payload: box.querySelector('.htt-mqtt-onpayload').value,
                off_topic: box.querySelector('.htt-mqtt-offtopic').value,
                off_payload: box.querySelector('.htt-mqtt-offpayload').value,
                state_topic: box.querySelector('.htt-mqtt-statetopic').value,
                state_is_json: box.querySelector('.htt-mqtt-statejson').checked,
                state_json_key: box.querySelector('.htt-mqtt-statekey').value || 'state',
            },
        });
    });
    httRules = rules;
    return rules;
}

function httSaveConfig() {
    const rules = httCollectRules();
    const config = { enabled: document.getElementById('htt-plugin-enabled').checked, poll_interval: parseInt(document.getElementById('htt-poll-interval').value) || 60, rules: rules };
    httPost('action=save_config&config=' + encodeURIComponent(JSON.stringify(config)))
        .then(r => r.json()).then(d => {
            document.getElementById('htt-save-msg').textContent = d.ok ? ' Saved and applied.' : ' Error saving: ' + (d.error || 'unknown error');
            setTimeout(() => document.getElementById('htt-save-msg').textContent = '', 3000);
            httRenderRules();
        }).catch(err => {
            document.getElementById('htt-save-msg').textContent = ' Error saving: ' + err;
        });
}

function httTestRule(i, on) {
    httCollectRules();
    const rule = httRules[i];
    httPost('action=test_command&rule=' + encodeURIComponent(JSON.stringify(rule)) + '&on=' + (on ? '1' : '0'))
        .then(r => r.json()).then(d => alert(d.ok ? 'Command sent successfully' : 'Command failed - check log'));
}

function httTestMqtt(i) {
    httCollectRules();
    const rule = httRules[i];
    httPost('action=test_mqtt&rule=' + encodeURIComponent(JSON.stringify(rule)))
        .then(r => r.json()).then(d => alert(d.ok ? 'MQTT connection OK' : 'MQTT connection failed: ' + (d.error || 'unknown error')));
}

function httCheckState(i) {
    httCollectRules();
    const rule = httRules[i];
    httPost('action=get_device_state&rule=' + encodeURIComponent(JSON.stringify(rule)))
        .then(r => r.json()).then(d => {
            if (!d.ok) { alert('Could not read device state: ' + (d.error || 'unknown error')); return; }
            const stateStr = d.state ? d.state.toUpperCase() : 'unrecognized';
            alert('Device reports: ' + stateStr + '\nRaw: ' + d.raw + '\n\n(internal tracked state has been synced to match)');
            httLoadStatus();
        });
}

function httServiceControl(cmd) {
    httPost('action=service_control&cmd=' + cmd).then(() => setTimeout(httLoadStatus, 1500));
}

function httTogglePluginEnabled(checkbox) {
    const config = { enabled: checkbox.checked, poll_interval: parseInt(document.getElementById('htt-poll-interval').value) || 60, rules: httCollectRules() };
    httPost('action=save_config&config=' + encodeURIComponent(JSON.stringify(config)))
        .then(r => r.json()).then(d => {
            const box = document.getElementById('htt-plugin-toggle');
            box.classList.remove('enabled', 'disabled');
            box.classList.add(checkbox.checked ? 'enabled' : 'disabled');
            if (!d.ok) alert('Failed to save: ' + (d.error || 'unknown error'));
        });
}

function httToggleYaml() {
    const ta = document.getElementById('htt-yaml-view');
    const isOpen = ta.style.display !== 'none';
    if (isOpen) {
        ta.style.display = 'none';
        document.getElementById('htt-yaml-download').style.display = 'none';
        document.getElementById('htt-yaml-apply').style.display = 'none';
        document.getElementById('htt-yaml-msg').textContent = '';
        document.getElementById('htt-yaml-toggle').textContent = 'View as YAML';
        return;
    }
    fetch(HTT_ENDPOINT + '?action=get_config_yaml', { credentials: 'same-origin' }).then(r => r.text()).then(yaml => {
        ta.value = yaml;
        ta.style.display = '';
        const link = document.getElementById('htt-yaml-download');
        const blob = new Blob([yaml], { type: 'text/yaml' });
        link.href = URL.createObjectURL(blob);
        link.download = 'unraid-disk-event-trigger.yaml';
        link.style.display = '';
        document.getElementById('htt-yaml-apply').style.display = '';
        document.getElementById('htt-yaml-toggle').textContent = 'Hide YAML';
    });
}

function httApplyYaml() {
    const yaml = document.getElementById('htt-yaml-view').value;
    const msg = document.getElementById('htt-yaml-msg');
    msg.textContent = ' Validating...';
    httPost('action=save_config_yaml&yaml=' + encodeURIComponent(yaml))
        .then(r => r.json()).then(d => {
            if (d.ok) {
                msg.textContent = ' Applied.';
                setTimeout(() => msg.textContent = '', 3000);
                // Refresh the rule editor / global settings from the newly saved config.
                fetch(HTT_ENDPOINT + '?action=get_config', { credentials: 'same-origin' }).then(r => r.json()).then(config => {
                    httRules = config.rules || [];
                    document.getElementById('htt-poll-interval').value = config.poll_interval ?? 60;
                    const pluginEnabled = document.getElementById('htt-plugin-enabled');
                    pluginEnabled.checked = config.enabled ?? true;
                    const box = document.getElementById('htt-plugin-toggle');
                    box.classList.remove('enabled', 'disabled');
                    box.classList.add(pluginEnabled.checked ? 'enabled' : 'disabled');
                    httCollapsedOverride = {};
                    httRenderRules();
                    httLoadStatus();
                });
            } else {
                msg.textContent = ' Not applied - ' + (d.error || 'unknown error');
            }
        }).catch(err => {
            msg.textContent = ' Not applied - ' + err;
        });
}

function httLoadStatus() {
    fetch(HTT_ENDPOINT + '?action=get_status', { credentials: 'same-origin' }).then(r => r.json()).then(d => {
        document.getElementById('htt-service-status').textContent = d.service_status;
        const a = d.array || {};
        document.getElementById('htt-array-status').textContent = a.active
            ? `Array operation in progress: ${a.action} (parity check: ${a.is_parity_check}, rebuild: ${a.is_rebuild})`
            : 'No parity check / rebuild in progress.';
        const tbody = document.getElementById('htt-disk-table');
        tbody.innerHTML = '';
        d.disks.forEach(disk => {
            tbody.innerHTML += `<tr><td>${disk.name}</td><td>${disk.device}</td><td>${disk.spundown?'yes':'no'}</td><td>${disk.spundown?'-':(disk.live_temp ?? '?')}</td></tr>`;
        });
        httLastState = d.state || {};
        document.querySelectorAll('.htt-relay-badge').forEach(badge => {
            const s = httLastState[badge.dataset.ruleId];
            badge.classList.remove('on', 'off');
            if (!s || !s.relay) {
                badge.textContent = 'State: unknown';
            } else {
                badge.classList.add(s.relay);
                badge.textContent = `State: ${s.relay.toUpperCase()}`;
            }
        });
    });
}

function httLoadLog() {
    fetch(HTT_ENDPOINT + '?action=get_log', { credentials: 'same-origin' }).then(r => r.json()).then(d => {
        document.getElementById('htt-log').innerHTML = '<div id="htt-status">' + (d.log || '(empty)').replace(/</g,'&lt;') + '</div>';
    });
}

function httClearLog() {
    if (!confirm('Clear the log?')) return;
    httPost('action=clear_log').then(r => r.json()).then(() => httLoadLog());
}

httRenderRules();
httLoadStatus();
httLoadLog();
setInterval(httLoadStatus, 15000);
</script>
