#!/bin/bash
# unraid-disk-event-trigger service control script (Unraid rc.d convention)

PIDFILE="/var/run/unraid-disk-event-trigger.pid"
DAEMON="/usr/local/emhttp/plugins/unraid-disk-event-trigger/scripts/poll_daemon.php"

start() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "unraid-disk-event-trigger already running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    echo "Starting unraid-disk-event-trigger..."
    nohup /usr/bin/php "$DAEMON" >/dev/null 2>&1 &
    echo $! > "$PIDFILE"
}

stop() {
    if [ -f "$PIDFILE" ]; then
        PID=$(cat "$PIDFILE")
        if kill -0 "$PID" 2>/dev/null; then
            echo "Stopping unraid-disk-event-trigger (pid $PID)..."
            kill "$PID"
            for i in $(seq 1 10); do
                kill -0 "$PID" 2>/dev/null || break
                sleep 1
            done
            kill -9 "$PID" 2>/dev/null
        fi
        rm -f "$PIDFILE"
    else
        echo "unraid-disk-event-trigger is not running"
    fi
}

status() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "unraid-disk-event-trigger is running (pid $(cat "$PIDFILE"))"
        return 0
    else
        echo "unraid-disk-event-trigger is not running"
        return 1
    fi
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    status) status ;;
    *) echo "usage: $0 start|stop|restart|status" ;;
esac
